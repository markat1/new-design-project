<Router AppAssembly="typeof(App).Assembly">
    <Found Context="route"><RouteView RouteData="route" DefaultLayout="typeof(Layout)" /></Found>
    <NotFound><LayoutView Layout="typeof(Layout)"><p class="boot">Siden findes ikke. Gå til <a href="">Trinliste</a> eller <a href="tjekliste">Tjekliste</a>.</p></LayoutView></NotFound>
</Router>
