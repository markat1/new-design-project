@implements IDisposable
@inject MailDraft S
@inject AppState App
@inject IJSRuntime JS

@* Asked only when "Ny udsendelse" would throw work away: there is one draft,
   and a new one takes its place. The question is the one the button press
   asked, and the text says what it costs. A native <dialog> — see
   app.dialog — so Escape and a click outside mean "keep it" for free. *@
<dialog class="dlg" @ref="el" aria-labelledby="dlg-new-h" aria-describedby="dlg-new-b">
    <h2 class="dlg-h" id="dlg-new-h">Start en ny udsendelse?</h2>
    <p class="dlg-b" id="dlg-new-b">
        Der er kun plads til én kladde ad gangen. Starter du en ny, bliver
        <b>»@S.Title«</b>@(S.Picked.Count == 0 ? "" : $" til {S.Picked.Count} {(S.Picked.Count == 1 ? "mail" : "mails")}") slettet.
    </p>
    <div class="dlg-acts">
        <button type="button" class="btn btn-danger" @onclick="Discard">@Icons.Trash Slet kladden og start ny</button>
        @* Focus opens here: Enter pressed without reading keeps the work. *@
        <button type="button" class="btn btn-outline" autofocus @onclick="Keep">Fortsæt kladden</button>
    </div>
</dialog>

@code {
    private ElementReference el;

    public async Task OpenAsync() => await JS.InvokeVoidAsync("app.dialog.open", el);

    private async Task Discard()
    {
        await JS.InvokeVoidAsync("app.dialog.close", el);
        App.Page = AppPage.Quote;
        S.StartOver();
    }

    /// "Fortsæt kladden" goes to the draft, wherever it was pressed from.
    private async Task Keep()
    {
        await JS.InvokeVoidAsync("app.dialog.close", el);
        App.Page = AppPage.Quote;
        S.NotifyChanged();
    }

    protected override void OnInitialized() => S.Changed += Redraw;
    public void Dispose() => S.Changed -= Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
}
