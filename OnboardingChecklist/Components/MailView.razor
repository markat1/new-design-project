@using System.Globalization
@using System.Text.RegularExpressions
@inject IJSRuntime JS

@* The send-out, rendered the same way whether it went out or is still being
   written. The recipients are a tab of their own: each customer gets a
   different sheet, so they are a list, not a line in the header. *@
<div class="d" @key="M.Ref">

    <div class="d-tabs" role="tablist" aria-label="Mail, modtagere og vedhæftning" @onkeydown="TabKey">
        <button type="button" class="d-tab" role="tab" id="d-tab-mail"
                aria-selected="@(tab == 0 ? "true" : "false")" aria-controls="d-panel-mail"
                tabindex="@(tab == 0 ? 0 : -1)" @onclick="() => tab = 0">Mail</button>
        <button type="button" class="d-tab" role="tab" id="d-tab-rcp"
                aria-selected="@(tab == 1 ? "true" : "false")" aria-controls="d-panel-rcp"
                tabindex="@(tab == 1 ? 0 : -1)" @onclick="() => tab = 1">
            Modtagere
            @if (M.Recipients.Length > 0)
            {
                <span class="d-tab-n">@M.Recipients.Length</span>
            }
        </button>
        <button type="button" class="d-tab" role="tab" id="d-tab-file"
                aria-selected="@(tab == 2 ? "true" : "false")" aria-controls="d-panel-file"
                tabindex="@(tab == 2 ? 0 : -1)" @onclick="() => tab = 2">Vedhæftning</button>
    </div>

    @if (tab == 0)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-mail" aria-labelledby="d-tab-mail">
            <h2 class="d-subject" data-empty="@(Blank(M.Subject) ? "" : null)">
                @Show(M.Subject, "Ingen emnelinje endnu")
            </h2>

            <dl class="d-meta">
                <div>
                    <dt>Til</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0
                            ? "Ingen modtagere endnu"
                            : M.Companies == 1
                                ? $"{M.Recipients.Length} hos 1 kunde"
                                : $"{M.Recipients.Length} hos {M.Companies} kunder")
                    </dd>
                </div>
                <div>
                    <dt>Ark</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0 ? "Ingen endnu" : $"{M.Companies} prislister · {M.Total:N0} i alt")
                    </dd>
                </div>
                <div>
                    <dt>@(Preview ? "Sendes" : "Sendt")</dt>
                    <dd class="num">@M.Sent</dd>
                </div>
                @if (!Preview && M.Status == MailStatus.Sent)
                {
                    <div><dt>Svar</dt><dd>@M.Responses</dd></div>
                }
            </dl>

            <div class="d-body" data-empty="@(Blank(M.Note) ? "" : null)">
                @(Blank(M.Note) ? (Preview ? "Ingen besked — den kan springes over." : "Sendt uden besked.") : M.Note)
            </div>
        </div>
    }
    else if (tab == 1)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-rcp" aria-labelledby="d-tab-rcp">
            @if (M.Recipients.Length == 0)
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen modtagere endnu</span>
                        <span class="d-file-s">Hver kunde får sin egen prisliste vedhæftet</span>
                    </span>
                </div>
            }
            else
            {
                <ul class="rcp">
                    @foreach (var r in M.Recipients)
                    {
                        var rec = r;
                        <li class="rcp-item" @key="rec.Email">
                            @* Opens the sheet in its own tab rather than under the row,
                               where four columns had to share a strip. *@
                            <button type="button" class="rcp-head" @onclick="() => Show(rec.Email)">
                                <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                                <span class="rcp-txt">
                                    <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                                    <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                                </span>
                                <span class="rcp-state">
                                    @if (!Preview)
                                    {
                                        <span class="t-pill" data-s="@rec.Status.ToString().ToLowerInvariant()">@rec.Status.Label()</span>
                                    }
                                </span>
                                <span class="rcp-sum num">@rec.Total.ToString("N0")</span>
                                <span class="rcp-go" aria-hidden="true">@Icons.Chevron</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <div class="d-panel d-panel-file" role="tabpanel" id="d-panel-file" aria-labelledby="d-tab-file">
            @if (Current is { } rec)
            {
                <div class="sheet-for">
                    <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                    <span class="rcp-txt">
                        <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                        <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                    </span>
                    @if (M.Recipients.Length > 1)
                    {
                        <span class="sheet-nav">
                            <button type="button" class="sheet-step" aria-label="Forrige modtager"
                                    disabled="@(Index <= 0)" @onclick="() => Step(-1)">@Icons.ArrowL</button>
                            <span class="sheet-count">@(Index + 1) / @M.Recipients.Length</span>
                            <button type="button" class="sheet-step sheet-next" aria-label="Næste modtager"
                                    disabled="@(Index >= M.Recipients.Length - 1)" @onclick="() => Step(1)">@Icons.ArrowL</button>
                        </span>
                    }
                </div>

                @if (Accounting.ViewerFor(rec.Company) is { } viewer)
                {
                    @* Excel itself, framed. Office for the web renders the workbook
                       where it lies — which is why this needs a link Microsoft can
                       reach: SharePoint, or a public address. Without one the app
                       draws the sheet below instead. *@
                    <iframe class="xl-office" src="@viewer" title="Prisliste for @rec.Company"
                            referrerpolicy="no-referrer"></iframe>
                }
                else if (rec.Lines.Length == 0)
                {
                    <p class="rcp-none">Ingen prisliste i regnskabssystemet for @rec.Company.</p>
                }
                else if (Sheet is { } tab)
                {
                    @* The workbook as it lies: every cell of the open worksheet, its
                       sheets along the bottom, and ruled rows carrying on past the
                       numbers. Letters and row numbers are the spreadsheet's own
                       furniture, so a screen reader skips them. *@
                    <div class="xl">
                        @if (autoCol is not null)
                        {
                            <div class="t-backdrop" @onclick="CloseAuto"></div>
                        }
                        <div class="xl-grid">
                            <table class="xl-t">
                                <colgroup>
                                    <col class="xl-c-n" />
                                    @for (var c = 0; c < Wide; c++)
                                    {
                                        <col style="width: @(Accounting.WidthPx(tab, c))px" />
                                    }
                                    @for (var c = Wide; c < Cols - 1; c++)
                                    {
                                        <col style="width: 64px" />
                                    }
                                    @* The last one takes whatever is left, so the grid
                                       reaches the pane's edge at any width. *@
                                    <col />
                                </colgroup>
                                <thead>
                                    <tr class="xl-head" aria-hidden="true">
                                        <td class="xl-corner"></td>
                                        @for (var c = 0; c < Cols; c++)
                                        {
                                            <td>@Accounting.ColumnName(c)</td>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var r = 0; r < tab.Rows.Count + 40; r++)
                                    {
                                        var line = r;
                                        var real = line < tab.Rows.Count;
                                        if (Hidden(tab, line)) { continue; }
                                        <tr class="@(real ? null : "xl-empty")" aria-hidden="@(real ? null : "true")">
                                            <td class="xl-n">@(line + 1)</td>
                                            @for (var c = 0; c < Cols; c++)
                                            {
                                                var col = c;
                                                var cell = col < Wide ? tab.At(line, col) : new Cell();
                                                var shownText = real && col < Wide ? Formulas.Display(tab, line, col) : "";
                                                var numeric = Formulas.Value(tab, line, col) is not null;
                                                var typedText = cell.Formula is null ? cell.Value : "=" + cell.Formula;
                                                var cellName = Accounting.ColumnName(col) + (line + 1);
                                                <td class="@Classes(cell, numeric)" data-open="@(autoCol == col && line == 0 ? "" : null)">
                                                    @if (Preview)
                                                    {
                                                        @* A draft's workbook can still be corrected; a sent
                                                           one is what went out, so it only reads. The cell
                                                           shows what it is worth, and the formula behind it
                                                           on a double click — the same formula that goes
                                                           into the file when it is saved. *@
                                                        <input aria-label="@cellName"
                                                               value="@(Editing(line, col) ? typedText : shownText)"
                                                               @ondblclick="() => editing = (line, col)"
                                                               @onchange="e => Typed(rec.Company, line, col, e.Value?.ToString() ?? string.Empty)"
                                                               @onblur="() => editing = null" />
                                                    }
                                                    else
                                                    {
                                                        @shownText
                                                    }

                                                    @if (line == 0 && real && col < Wide && !cell.Blank && Sorts(tab))
                                                    {
                                                        @* Excel's autofilter: the header cell opens the
                                                           column's own sort and filter. *@
                                                        <button type="button" class="xl-af" id="af-@col"
                                                                data-on="@(Narrowed(col) ? "" : null)"
                                                                aria-haspopup="dialog" aria-expanded="@(autoCol == col ? "true" : "false")"
                                                                aria-label="Sortér og filtrér @cellName"
                                                                @onclick="() => ToggleAuto(col)">@Icons.Chevron</button>

                                                        @if (autoCol == col)
                                                        {
                                                            var numberColumn = IsNumberColumn(tab, col);
                                                            <div class="t-menu xl-af-menu" role="dialog" tabindex="-1"
                                                                 aria-label="Sortér og filtrér @shownText" @ref="autoMenu" @onkeydown="AutoKey">
                                                                <span class="t-menu-head">Sortér</span>
                                                                <button type="button" class="t-menu-item" @onclick="() => Sort(tab, col, true)">
                                                                    <span class="t-menu-ico">@Icons.ArrowUp</span>
                                                                    @(numberColumn ? "Mindst øverst" : "A til Å")
                                                                </button>
                                                                <button type="button" class="t-menu-item" @onclick="() => Sort(tab, col, false)">
                                                                    <span class="t-menu-ico xl-down">@Icons.ArrowUp</span>
                                                                    @(numberColumn ? "Størst øverst" : "Å til A")
                                                                </button>

                                                                <div class="t-menu-filter">
                                                                    <span class="t-menu-head">Vis</span>
                                                                    <ul class="t-menu-list">
                                                                        @foreach (var v in ValuesIn(tab, col))
                                                                        {
                                                                            var value = v;
                                                                            <li>
                                                                                <label class="t-menu-check">
                                                                                    <input type="checkbox" checked="@Showing(col, value)"
                                                                                           @onchange="() => ToggleValue(tab, col, value)" />
                                                                                    <span title="@value">@value</span>
                                                                                </label>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>

                                                                @if (Narrowed(col))
                                                                {
                                                                    <button type="button" class="t-menu-clear" @onclick="() => ClearAuto(col)">Ryd filter</button>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* The workbook's own sheets, along the bottom where a workbook
                           keeps them. *@
                        <div class="xl-foot">
                            <div class="xl-tabs" role="tablist" aria-label="Ark i @rec.Attachment">
                                @for (var t = 0; t < Tabs.Length; t++)
                                {
                                    var at = t;
                                    <button type="button" class="xl-tab" role="tab" title="@Tabs[at].Name — @rec.Attachment"
                                            aria-selected="@(at == sheetTab ? "true" : "false")"
                                            data-on="@(at == sheetTab ? "" : null)"
                                            @onclick="() => sheetTab = at">@Tabs[at].Name</button>
                                }
                            </div>
                            @if (Preview && Accounting.IsEdited(rec.Company))
                            {
                                <span class="xl-dirty">ikke gemt</span>
                                <button type="button" class="xl-save" @onclick="() => Save(rec.Company)">Gem ark</button>
                            }
                            else
                            {
                                <span class="xl-size">@rec.AttachmentSize</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen vedhæftning endnu</span>
                        <span class="d-file-s">Vælg modtagere, så bygges arkene her</span>
                    </span>
                </div>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public Mail M { get; set; } = default!;

    /// A mail still being written: empty fields say what is still missing rather
    /// than leaving a gap that reads as a rendering fault, and its price sheets
    /// can still be corrected.
    [Parameter] public bool Preview { get; set; }

    /// Raised when a cell changes, so the page above rebuilds the draft from
    /// the sheets it now holds.
    [Parameter] public EventCallback SheetEdited { get; set; }

    private int tab;
    private string? shown;
    private int sheetTab;

    /// The open customer's workbook, and the worksheet showing from it.
    private Tab[] Tabs => Current is { } rec ? Accounting.TabsFor(rec.Company) : [];

    private Tab? Sheet => sheetTab < Tabs.Length ? Tabs[sheetTab] : Tabs.FirstOrDefault();

    /// Four columns at the least, so a narrow sheet still reads as paper.
    private int Wide => Math.Max(4, Sheet?.Width ?? 4);

    /// The sheet's own columns, then eight of Excel's empty ones, then one
    /// that takes the rest of the pane — the grid carries on sideways the way
    /// it carries on downwards.
    private int Cols => Wide + 9;

    // ---- the worksheet's own sort and filter, as Excel's autofilter ----

    /// The cell showing its formula rather than its value, as Excel does when
    /// you open a cell for editing.
    private (int Row, int Col)? editing;

    private bool Editing(int row, int column) => editing == (row, column);

    private int? autoCol;
    private ElementReference autoMenu;
    private bool focusAuto;
    private string? focusAfter;

    /// The values a column is narrowed to. No entry means the column shows
    /// everything, which is not the same as an entry that happens to be empty.
    private readonly Dictionary<string, HashSet<string>> narrow = [];

    private string Key(int column) => $"{Current?.Company}:{sheetTab}:{column}";

    /// The rows the filter and the sort work on: under the header, down to the
    /// first blank or bold row. A sum is bold, and it stays where it is.
    private static (int From, int To) DataRange(Tab tab)
    {
        var to = 0;

        for (var row = 1; row < tab.Rows.Count; row++)
        {
            if (tab.Rows[row].All(cell => cell.Blank) || tab.Rows[row].Any(cell => cell.Bold)) break;
            to = row;
        }

        return (1, to);
    }

    private static bool Sorts(Tab tab) => DataRange(tab) is var (from, to) && to >= from;

    private static bool IsNumberColumn(Tab tab, int column)
    {
        var (from, to) = DataRange(tab);
        return to >= from && Enumerable.Range(from, to - from + 1).All(row => Formulas.Value(tab, row, column) is not null);
    }

    private IEnumerable<string> ValuesIn(Tab tab, int column)
    {
        var (from, to) = DataRange(tab);
        return Enumerable.Range(from, Math.Max(0, to - from + 1))
            .Select(row => Formulas.Display(tab, row, column))
            .Distinct()
            .Order();
    }

    private bool Narrowed(int column) => narrow.ContainsKey(Key(column));

    private bool Showing(int column, string value) =>
        !narrow.TryGetValue(Key(column), out var set) || set.Contains(value);

    private bool Hidden(Tab tab, int line)
    {
        var (from, to) = DataRange(tab);
        if (line < from || line > to) return false;

        for (var column = 0; column < Wide; column++)
        {
            if (narrow.TryGetValue(Key(column), out var set) && !set.Contains(Formulas.Display(tab, line, column))) return true;
        }

        return false;
    }

    private void ToggleValue(Tab tab, int column, string value)
    {
        var all = ValuesIn(tab, column).ToList();
        var key = Key(column);

        if (!narrow.TryGetValue(key, out var set)) narrow[key] = set = [.. all];
        if (!set.Remove(value)) set.Add(value);
        if (set.Count == all.Count) narrow.Remove(key);
    }

    private void ClearAuto(int column)
    {
        narrow.Remove(Key(column));
        focusAuto = true;
    }

    private void ToggleAuto(int column)
    {
        autoCol = autoCol == column ? null : column;
        focusAuto = autoCol is not null;
    }

    private void CloseAuto()
    {
        if (autoCol is { } column) focusAfter = $"af-{column}";
        autoCol = null;
    }

    private void AutoKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseAuto();
    }

    /// Sorting moves rows, and a moved row takes its formulas with it — so the
    /// references in them are rewritten to the row they land on, the way Excel
    /// does it. The sum below the range keeps pointing at the same range.
    private async Task Sort(Tab tab, int column, bool ascending)
    {
        var (from, to) = DataRange(tab);
        if (to <= from)
        {
            CloseAuto();
            return;
        }

        var rows = Enumerable.Range(from, to - from + 1)
            .Select(row => (row, cells: tab.Rows[row], text: Formulas.Display(tab, row, column), number: Formulas.Value(tab, row, column)))
            .ToList();

        var sorted = IsNumberColumn(tab, column)
            ? (ascending ? rows.OrderBy(r => r.number) : rows.OrderByDescending(r => r.number)).ToList()
            : (ascending ? rows.OrderBy(r => r.text, StringComparer.CurrentCulture) : rows.OrderByDescending(r => r.text, StringComparer.CurrentCulture)).ToList();

        for (var i = 0; i < sorted.Count; i++)
        {
            tab.Rows[from + i] = Moved(sorted[i].cells, sorted[i].row, from + i);
        }

        if (Current is { } rec) Accounting.Touch(rec.Company);
        CloseAuto();
        await SheetEdited.InvokeAsync();
    }

    private static List<Cell> Moved(List<Cell> cells, int was, int now)
    {
        if (was == now) return cells;

        return [.. cells.Select(cell => cell.Formula is null
            ? cell
            : cell with { Formula = Regex.Replace(cell.Formula, $@"(?<col>\$?[A-Z]+\$?){was + 1}\b", $"${{col}}{now + 1}") })];
    }

    private string? Classes(Cell cell, bool numeric)
    {
        var classes = new List<string>();
        if (Preview) classes.Add("xl-edit");
        if (numeric) classes.Add("num");
        if (cell.Bold) classes.Add("xl-b");

        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    /// The recipient whose sheet the third tab shows. Defaults to the first, so
    /// the tab is never blank when there is something to show.
    private Recipient? Current =>
        M.Recipients.FirstOrDefault(r => r.Email == shown) ?? M.Recipients.FirstOrDefault();

    private int Index => Current is null ? -1 : Array.FindIndex(M.Recipients, r => r.Email == Current.Email);

    private void Show(string email)
    {
        shown = email;
        sheetTab = 0;
        editing = null;
        tab = 2;
    }

    private void Step(int by)
    {
        var next = Index + by;
        if (next < 0 || next >= M.Recipients.Length) return;

        shown = M.Recipients[next].Email;
        sheetTab = 0;
    }

    /// A cell was typed into. The workbook is the accounting system's, so the
    /// edit goes there and every figure reading from it — this grid, the
    /// recipient's sum, the send-out's total in the list — follows on the next
    /// render.
    private async Task Typed(string company, int row, int column, string text)
    {
        editing = null;
        Accounting.SetCell(company, sheetTab, row, column, text);
        await SheetEdited.InvokeAsync();
    }

    /// Written back out as a real workbook, by the same SDK that read it, and
    /// handed to the browser as a file. Saving in place would need somewhere to
    /// put it: the accounting system's own store, or the browser's file access.
    private async Task Save(string company)
    {
        var file = Accounting.Write(company);
        await JS.InvokeVoidAsync("app.saveFile", Accounting.FileFor(company), file,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        await SheetEdited.InvokeAsync();
    }

    private static bool Blank(string s) => s.Trim().Length == 0;

    private static string Show(string value, string fallback) =>
        value.Trim().Length > 0 ? value : fallback;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (focusAuto)
        {
            focusAuto = false;
            await JS.InvokeVoidAsync("app.focusIn", autoMenu);
        }
        else if (focusAfter is { } id)
        {
            focusAfter = null;
            await JS.InvokeVoidAsync("app.focusId", id);
        }
    }

    private void TabKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") tab = Math.Min(tab + 1, 2);
        else if (e.Key == "ArrowLeft") tab = Math.Max(tab - 1, 0);
        else if (e.Key == "Home") tab = 0;
        else if (e.Key == "End") tab = 2;
    }
}
