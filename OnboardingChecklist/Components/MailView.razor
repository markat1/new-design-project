@* The send-out, rendered the same way whether it went out or is still being
   written. The recipients are a tab of their own: each customer gets a
   different sheet, so they are a list, not a line in the header. *@
<div class="d" @key="M.Ref">

    <div class="d-top">
        <span class="t-pill" data-s="@M.Status.ToString().ToLowerInvariant()">@(Preview ? "Udkast" : M.Label)</span>
        <span class="d-ref">@M.Ref</span>
    </div>

    <div class="d-tabs" role="tablist" aria-label="Mail, modtagere og vedhæftning" @onkeydown="TabKey">
        <button type="button" class="d-tab" role="tab" id="d-tab-mail"
                aria-selected="@(tab == 0 ? "true" : "false")" aria-controls="d-panel-mail"
                tabindex="@(tab == 0 ? 0 : -1)" @onclick="() => tab = 0">Mail</button>
        <button type="button" class="d-tab" role="tab" id="d-tab-rcp"
                aria-selected="@(tab == 1 ? "true" : "false")" aria-controls="d-panel-rcp"
                tabindex="@(tab == 1 ? 0 : -1)" @onclick="() => tab = 1">
            Modtagere
            @if (M.Recipients.Length > 0)
            {
                <span class="d-tab-n">@M.Recipients.Length</span>
            }
        </button>
        <button type="button" class="d-tab" role="tab" id="d-tab-file"
                aria-selected="@(tab == 2 ? "true" : "false")" aria-controls="d-panel-file"
                tabindex="@(tab == 2 ? 0 : -1)" @onclick="() => tab = 2">Vedhæftning</button>
    </div>

    @if (tab == 0)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-mail" aria-labelledby="d-tab-mail">
            <h2 class="d-subject" data-empty="@(Blank(M.Subject) ? "" : null)">
                @Show(M.Subject, "Ingen emnelinje endnu")
            </h2>

            <dl class="d-meta">
                <div>
                    <dt>Til</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0
                            ? "Ingen modtagere endnu"
                            : M.Companies == 1
                                ? $"{M.Recipients.Length} hos 1 kunde"
                                : $"{M.Recipients.Length} hos {M.Companies} kunder")
                    </dd>
                </div>
                <div>
                    <dt>Ark</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0 ? "Ingen endnu" : $"{M.Companies} prislister · {M.Total:N0} i alt")
                    </dd>
                </div>
                <div>
                    <dt>@(Preview ? "Sendes" : "Sendt")</dt>
                    <dd class="num">@M.Sent</dd>
                </div>
                @if (!Preview && M.Status == MailStatus.Sent)
                {
                    <div><dt>Svar</dt><dd>@M.Responses</dd></div>
                }
            </dl>

            <div class="d-body" data-empty="@(Blank(M.Note) ? "" : null)">
                @(Blank(M.Note) ? (Preview ? "Ingen besked — den kan springes over." : "Sendt uden besked.") : M.Note)
            </div>
        </div>
    }
    else if (tab == 1)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-rcp" aria-labelledby="d-tab-rcp">
            @if (M.Recipients.Length == 0)
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen modtagere endnu</span>
                        <span class="d-file-s">Hver kunde får sin egen prisliste vedhæftet</span>
                    </span>
                </div>
            }
            else
            {
                <ul class="rcp">
                    @foreach (var r in M.Recipients)
                    {
                        var rec = r;
                        <li class="rcp-item" @key="rec.Email">
                            @* Opens the sheet in its own tab rather than under the row,
                               where four columns had to share a strip. *@
                            <button type="button" class="rcp-head" @onclick="() => Show(rec.Email)">
                                <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                                <span class="rcp-txt">
                                    <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                                    <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                                </span>
                                <span class="rcp-state">
                                    @if (!Preview)
                                    {
                                        <span class="t-pill" data-s="@rec.Status.ToString().ToLowerInvariant()">@rec.Status.Label()</span>
                                    }
                                </span>
                                <span class="rcp-sum num">@rec.Total.ToString("N0")</span>
                                <span class="rcp-go" aria-hidden="true">@Icons.Chevron</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <div class="d-panel" role="tabpanel" id="d-panel-file" aria-labelledby="d-tab-file">
            @if (Current is { } rec)
            {
                <div class="sheet-for">
                    <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                    <span class="rcp-txt">
                        <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                        <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                    </span>
                    @if (M.Recipients.Length > 1)
                    {
                        <span class="sheet-nav">
                            <button type="button" class="sheet-step" aria-label="Forrige modtager"
                                    disabled="@(Index <= 0)" @onclick="() => Step(-1)">@Icons.ArrowL</button>
                            <span class="sheet-count">@(Index + 1) / @M.Recipients.Length</span>
                            <button type="button" class="sheet-step sheet-next" aria-label="Næste modtager"
                                    disabled="@(Index >= M.Recipients.Length - 1)" @onclick="() => Step(1)">@Icons.ArrowL</button>
                        </span>
                    }
                </div>

                <div class="d-file">
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n" title="@rec.Attachment">@rec.Attachment</span>
                        <span class="d-file-s">Regneark · @rec.AttachmentSize</span>
                    </span>
                </div>

                @if (rec.Lines.Length == 0)
                {
                    <p class="rcp-none">Ingen prisliste i regnskabssystemet for @rec.Company.</p>
                }
                else
                {
                    <table class="d-lines">
                        <thead>
                            <tr>
                                <th scope="col">Beskrivelse</th>
                                <th scope="col" class="num">Antal</th>
                                <th scope="col" class="num">Stykpris</th>
                                <th scope="col" class="num">I alt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in rec.Lines)
                            {
                                <tr>
                                    <td>@l.Description</td>
                                    <td class="num d-qty">@l.Qty</td>
                                    <td class="num">@l.Unit.ToString("N0")</td>
                                    <td class="num d-tot">@l.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td colspan="3">I alt</td><td class="num">@rec.Total.ToString("N0")</td></tr>
                        </tfoot>
                    </table>
                }
            }
            else
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen vedhæftning endnu</span>
                        <span class="d-file-s">Vælg modtagere, så bygges arkene her</span>
                    </span>
                </div>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public Mail M { get; set; } = default!;

    /// A mail still being written: empty fields say what is still missing rather
    /// than leaving a gap that reads as a rendering fault.
    [Parameter] public bool Preview { get; set; }

    private int tab;
    private string? shown;

    /// The recipient whose sheet the third tab shows. Defaults to the first, so
    /// the tab is never blank when there is something to show.
    private Recipient? Current =>
        M.Recipients.FirstOrDefault(r => r.Email == shown) ?? M.Recipients.FirstOrDefault();

    private int Index => Current is null ? -1 : Array.FindIndex(M.Recipients, r => r.Email == Current.Email);

    private void Show(string email)
    {
        shown = email;
        tab = 2;
    }

    private void Step(int by)
    {
        var next = Index + by;
        if (next >= 0 && next < M.Recipients.Length) shown = M.Recipients[next].Email;
    }

    private static bool Blank(string s) => s.Trim().Length == 0;

    private static string Show(string value, string fallback) =>
        value.Trim().Length > 0 ? value : fallback;

    private void TabKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") tab = Math.Min(tab + 1, 2);
        else if (e.Key == "ArrowLeft") tab = Math.Max(tab - 1, 0);
        else if (e.Key == "Home") tab = 0;
        else if (e.Key == "End") tab = 2;
    }
}
