@using System.Globalization
@inject IJSRuntime JS

@* The send-out, rendered the same way whether it went out or is still being
   written. The recipients are a tab of their own: each customer gets a
   different sheet, so they are a list, not a line in the header. *@
<div class="d" @key="M.Ref">

    @* Only over a mail that exists. While one is being written, "Udkast" and a
       reference it has not been given yet said nothing the page did not. *@
    @if (!Preview)
    {
        <div class="d-top">
            <span class="t-pill" data-s="@M.Status.ToString().ToLowerInvariant()">@M.Label</span>
            <span class="d-ref">@M.Ref</span>
        </div>
    }

    <div class="d-tabs" role="tablist" aria-label="Mail, modtagere og vedhæftning" @onkeydown="TabKey">
        <button type="button" class="d-tab" role="tab" id="d-tab-mail"
                aria-selected="@(tab == 0 ? "true" : "false")" aria-controls="d-panel-mail"
                tabindex="@(tab == 0 ? 0 : -1)" @onclick="() => tab = 0">Mail</button>
        <button type="button" class="d-tab" role="tab" id="d-tab-rcp"
                aria-selected="@(tab == 1 ? "true" : "false")" aria-controls="d-panel-rcp"
                tabindex="@(tab == 1 ? 0 : -1)" @onclick="() => tab = 1">
            Modtagere
            @if (M.Recipients.Length > 0)
            {
                <span class="d-tab-n">@M.Recipients.Length</span>
            }
        </button>
        <button type="button" class="d-tab" role="tab" id="d-tab-file"
                aria-selected="@(tab == 2 ? "true" : "false")" aria-controls="d-panel-file"
                tabindex="@(tab == 2 ? 0 : -1)" @onclick="() => tab = 2">Vedhæftning</button>
    </div>

    @if (tab == 0)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-mail" aria-labelledby="d-tab-mail">
            <h2 class="d-subject" data-empty="@(Blank(M.Subject) ? "" : null)">
                @Show(M.Subject, "Ingen emnelinje endnu")
            </h2>

            <dl class="d-meta">
                <div>
                    <dt>Til</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0
                            ? "Ingen modtagere endnu"
                            : M.Companies == 1
                                ? $"{M.Recipients.Length} hos 1 kunde"
                                : $"{M.Recipients.Length} hos {M.Companies} kunder")
                    </dd>
                </div>
                <div>
                    <dt>Ark</dt>
                    <dd data-empty="@(M.Recipients.Length == 0 ? "" : null)">
                        @(M.Recipients.Length == 0 ? "Ingen endnu" : $"{M.Companies} prislister · {M.Total:N0} i alt")
                    </dd>
                </div>
                <div>
                    <dt>@(Preview ? "Sendes" : "Sendt")</dt>
                    <dd class="num">@M.Sent</dd>
                </div>
                @if (!Preview && M.Status == MailStatus.Sent)
                {
                    <div><dt>Svar</dt><dd>@M.Responses</dd></div>
                }
            </dl>

            <div class="d-body" data-empty="@(Blank(M.Note) ? "" : null)">
                @(Blank(M.Note) ? (Preview ? "Ingen besked — den kan springes over." : "Sendt uden besked.") : M.Note)
            </div>
        </div>
    }
    else if (tab == 1)
    {
        <div class="d-panel" role="tabpanel" id="d-panel-rcp" aria-labelledby="d-tab-rcp">
            @if (M.Recipients.Length == 0)
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen modtagere endnu</span>
                        <span class="d-file-s">Hver kunde får sin egen prisliste vedhæftet</span>
                    </span>
                </div>
            }
            else
            {
                <ul class="rcp">
                    @foreach (var r in M.Recipients)
                    {
                        var rec = r;
                        <li class="rcp-item" @key="rec.Email">
                            @* Opens the sheet in its own tab rather than under the row,
                               where four columns had to share a strip. *@
                            <button type="button" class="rcp-head" @onclick="() => Show(rec.Email)">
                                <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                                <span class="rcp-txt">
                                    <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                                    <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                                </span>
                                <span class="rcp-state">
                                    @if (!Preview)
                                    {
                                        <span class="t-pill" data-s="@rec.Status.ToString().ToLowerInvariant()">@rec.Status.Label()</span>
                                    }
                                </span>
                                <span class="rcp-sum num">@rec.Total.ToString("N0")</span>
                                <span class="rcp-go" aria-hidden="true">@Icons.Chevron</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <div class="d-panel d-panel-file" role="tabpanel" id="d-panel-file" aria-labelledby="d-tab-file">
            @if (Current is { } rec)
            {
                <div class="sheet-for">
                    <span class="rcp-av" aria-hidden="true">@rec.Initials</span>
                    <span class="rcp-txt">
                        <span class="rcp-name" title="@rec.Name">@rec.Name</span>
                        <span class="rcp-co" title="@rec.Company">@rec.Company</span>
                    </span>
                    @if (M.Recipients.Length > 1)
                    {
                        <span class="sheet-nav">
                            <button type="button" class="sheet-step" aria-label="Forrige modtager"
                                    disabled="@(Index <= 0)" @onclick="() => Step(-1)">@Icons.ArrowL</button>
                            <span class="sheet-count">@(Index + 1) / @M.Recipients.Length</span>
                            <button type="button" class="sheet-step sheet-next" aria-label="Næste modtager"
                                    disabled="@(Index >= M.Recipients.Length - 1)" @onclick="() => Step(1)">@Icons.ArrowL</button>
                        </span>
                    }
                </div>

                @if (Accounting.ViewerFor(rec.Company) is { } viewer)
                {
                    @* Excel itself, framed. Office for the web renders the workbook
                       where it lies — which is why this needs a link Microsoft can
                       reach: SharePoint, or a public address. Without one the app
                       draws the sheet below instead. *@
                    <iframe class="xl-office" src="@viewer" title="Prisliste for @rec.Company"
                            referrerpolicy="no-referrer"></iframe>
                }
                else if (rec.Lines.Length == 0)
                {
                    <p class="rcp-none">Ingen prisliste i regnskabssystemet for @rec.Company.</p>
                }
                else
                {
                    @* The sheet as the accounting system holds it: the cells, not a
                       summary of them. Letters and row numbers are the spreadsheet's
                       own furniture, so they are hidden from a screen reader, which
                       gets the header row instead. *@
                    <div class="xl">
                        <div class="xl-grid">
                            <table class="xl-t">
                                <thead>
                                    <tr class="xl-head" aria-hidden="true">
                                        <td class="xl-corner"></td>
                                        <td>A</td>
                                        <td>B</td>
                                        <td>C</td>
                                        <td>D</td>
                                    </tr>
                                    <tr>
                                        <td class="xl-n" aria-hidden="true">1</td>
                                        <th scope="col">Beskrivelse</th>
                                        <th scope="col" class="num">Antal</th>
                                        <th scope="col" class="num">Stykpris</th>
                                        <th scope="col" class="num">I alt</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var row = 1; }
                                    @foreach (var l in rec.Lines)
                                    {
                                        var line = l;
                                        var at = row - 1;
                                        row++;
                                        <tr>
                                            <td class="xl-n" aria-hidden="true">@row</td>
                                            @if (Preview)
                                            {
                                                @* A draft's sheet can still be corrected; a sent one is
                                                   what went out, so it only reads. D is Excel's own
                                                   =B*C, so it is worked out, not typed. *@
                                                <td class="xl-edit">
                                                    <input aria-label="Beskrivelse, række @row" value="@line.Description"
                                                           @onchange="e => SetCell(rec.Company, at, 'A', e.Value?.ToString() ?? string.Empty)" />
                                                </td>
                                                <td class="xl-edit num">
                                                    <input class="num" inputmode="numeric" aria-label="Antal, række @row" value="@line.Qty"
                                                           @onchange="e => SetCell(rec.Company, at, 'B', e.Value?.ToString() ?? string.Empty)" />
                                                </td>
                                                <td class="xl-edit num">
                                                    <input class="num" inputmode="decimal" aria-label="Stykpris, række @row" value="@line.Unit.ToString("0.##")"
                                                           @onchange="e => SetCell(rec.Company, at, 'C', e.Value?.ToString() ?? string.Empty)" />
                                                </td>
                                            }
                                            else
                                            {
                                                <td>@line.Description</td>
                                                <td class="num">@line.Qty</td>
                                                <td class="num">@line.Unit.ToString("N0")</td>
                                            }
                                            <td class="num">@line.Total.ToString("N0")</td>
                                        </tr>
                                    }
                                    <tr class="xl-sum">
                                        <td class="xl-n" aria-hidden="true">@(row + 1)</td>
                                        <th scope="row">I alt</th>
                                        <td></td>
                                        <td></td>
                                        <td class="num">@rec.Total.ToString("N0")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @* The worksheet's own name, off the tab inside the workbook,
                           then the file the mail carries and what it weighs. *@
                        <div class="xl-foot">
                            <span class="xl-tab">@Accounting.SheetName(rec.Company)</span>
                            <span class="xl-file" title="@rec.Attachment">@rec.Attachment</span>
                            @if (Preview && Accounting.IsEdited(rec.Company))
                            {
                                <span class="xl-dirty">ikke gemt</span>
                                <button type="button" class="xl-save" @onclick="() => Save(rec.Company)">Gem ark</button>
                            }
                            else
                            {
                                <span class="xl-size">@rec.AttachmentSize</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="d-file" data-empty>
                    @Icons.Sheet
                    <span class="d-file-txt">
                        <span class="d-file-n">Ingen vedhæftning endnu</span>
                        <span class="d-file-s">Vælg modtagere, så bygges arkene her</span>
                    </span>
                </div>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public Mail M { get; set; } = default!;

    /// A mail still being written: empty fields say what is still missing rather
    /// than leaving a gap that reads as a rendering fault, and its price sheets
    /// can still be corrected.
    [Parameter] public bool Preview { get; set; }

    /// Raised when a cell changes, so the page above rebuilds the draft from
    /// the sheets it now holds.
    [Parameter] public EventCallback SheetEdited { get; set; }

    private int tab;
    private string? shown;

    /// The recipient whose sheet the third tab shows. Defaults to the first, so
    /// the tab is never blank when there is something to show.
    private Recipient? Current =>
        M.Recipients.FirstOrDefault(r => r.Email == shown) ?? M.Recipients.FirstOrDefault();

    private int Index => Current is null ? -1 : Array.FindIndex(M.Recipients, r => r.Email == Current.Email);

    private void Show(string email)
    {
        shown = email;
        tab = 2;
    }

    private void Step(int by)
    {
        var next = Index + by;
        if (next >= 0 && next < M.Recipients.Length) shown = M.Recipients[next].Email;
    }

    /// A cell was typed into. The sheet is the accounting system's, so the edit
    /// goes there and every figure that reads from it — this grid, the
    /// recipient's sum, the total out in the list — follows on the next render.
    private async Task SetCell(string company, int at, char column, string typed)
    {
        var lines = Accounting.SheetFor(company).ToArray();
        if (at < 0 || at >= lines.Length) return;

        var line = lines[at];
        lines[at] = column switch
        {
            'A' => line with { Description = typed.Trim() },
            'B' => int.TryParse(typed, NumberStyles.Any, CultureInfo.CurrentCulture, out var qty) ? line with { Qty = qty } : line,
            _ => decimal.TryParse(typed, NumberStyles.Any, CultureInfo.CurrentCulture, out var unit) ? line with { Unit = unit } : line,
        };

        Accounting.Replace(company, lines);
        await SheetEdited.InvokeAsync();
    }

    /// Written back out as a real workbook, by the same SDK that read it, and
    /// handed to the browser as a file. Saving in place would need somewhere to
    /// put it: the accounting system's own store, or the browser's file access.
    private async Task Save(string company)
    {
        var file = Accounting.Write(company);
        await JS.InvokeVoidAsync("app.saveFile", Accounting.FileFor(company), file,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        await SheetEdited.InvokeAsync();
    }

    private static bool Blank(string s) => s.Trim().Length == 0;

    private static string Show(string value, string fallback) =>
        value.Trim().Length > 0 ? value : fallback;

    private void TabKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") tab = Math.Min(tab + 1, 2);
        else if (e.Key == "ArrowLeft") tab = Math.Max(tab - 1, 0);
        else if (e.Key == "Home") tab = 0;
        else if (e.Key == "End") tab = 2;
    }
}
