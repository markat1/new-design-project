@inject MailDraft S
@inject MailStore Store
@inject IJSRuntime JS

@* One step's fields. Which step is the only thing that changes; validation and
   state live on the draft. *@
<div class="f-fields" @ref="root" @onkeydown="RootKey">

    @if (TaskKey == "recipients")
    {
        @* Three lists answer this on most days, so they are on screen with the
           numbers that earn them the place — choosing one is a click, not a
           search. The field under them is for the fourth day, and reaches the
           hundred others. *@
        <div class="grp">
            <div class="grp-cards" role="group" aria-label="Mest brugte marketinglister">
                @foreach (var (g, i) in Cards.Select((g, i) => (g, i)))
                {
                    var group = g;
                    var on = S.Chosen(group);
                    var shut = Blocked(group);

                    <button type="button" class="grp-card" id="grp-card-@i"
                            aria-pressed="@(on ? "true" : "false")" aria-disabled="@(shut ? "true" : null)"
                            @onclick="() => Pick(group)" @onkeydown="e => CardKey(e, i)">
                        <span class="grp-card-n">
                            <span class="grp-card-tick" aria-hidden="true">@if (on) { @Icons.TickSm }</span>
                            <span class="grp-card-name">@group.Name</span>
                        </span>
                        <span class="grp-card-s">@group.People.Length personer · @group.Customers kunder</span>
                        <span class="grp-card-sum num">
                            @group.Total.ToString("N0")<span class="grp-card-u">@Used(group)</span>
                        </span>
                    </button>
                }
            </div>

            @* The rule, where the rule bites. Two ticked cards and a third that
               will not take is a puzzle; two ticked cards and this line is an
               instruction. *@
            <p class="grp-rule">
                @if (S.Lists.Count == 0)
                {
                    <text>Vælg den liste, udsendelsen skal gå til — op til @MailDraft.MaxLists.</text>
                }
                else if (S.RoomForMore)
                {
                    <text>Du kan vælge én liste mere, eller klikke den valgte fra igen.</text>
                }
                else
                {
                    <text>Højst @MailDraft.MaxLists lister. Fjern én for at vælge en anden.</text>
                }
                @if (S.OnBoth.Length > 0)
                {
                    <span class="grp-rule-b">@S.OnBoth.Length @(S.OnBoth.Length == 1 ? "person står" : "personer står") på begge lister og får én mail.</span>
                }
            </p>

            @* The field is the control, not a button in front of one: the
               hundred others are one click away, and that click is the one
               you were going to make anyway. *@
            <div class="grp-find">
                <span class="grp-find-ico" aria-hidden="true">@Icons.Search</span>
                <input class="grp-find-input" id="grp-find" type="search"
                       placeholder="Søg i alle @MarketingGroup.Lists.Length lister, personer og kunder"
                       aria-label="Søg i alle @MarketingGroup.Lists.Length marketinglister"
                       role="combobox" aria-expanded="@(listOpen ? "true" : "false")"
                       aria-controls="grp-list" aria-autocomplete="list"
                       autocomplete="off" spellcheck="false" data-1p-ignore data-lpignore="true"
                       value="@listFind" @onclick="OpenLists"
                       @oninput="e => FindChanged(e.Value?.ToString() ?? string.Empty)"
                       @onkeydown="ListKey" @onkeydown:stopPropagation="true" />
                @if (listFind.Length > 0)
                {
                    <button type="button" class="t-find-x" aria-label="Ryd søgning"
                            @onclick="() => FindChanged(string.Empty)">@Icons.X</button>
                }
            </div>

            @if (listOpen)
            {
                @* A click anywhere else is an answer too: it means "not now".
                   The backdrop catches it before it reaches whatever was
                   behind, so nothing else moves on the way out. *@
                <div class="t-backdrop" @onclick="CloseLists"></div>

                @* The keys work from anywhere in the sheet, not only from the
                   field: click a row and focus is in here, and Escape has to
                   still mean escape. *@
                <div class="t-menu grp-menu" @onkeydown="ListKey" @onkeydown:stopPropagation="true">
                    <div class="grp-scroll" id="grp-list" role="listbox" aria-label="Marketinglister">
                        @{ var rows = Rows(); }
                        @if (rows.Length == 0)
                        {
                            <p class="t-menu-none">Ingen lister med "@listFind.Trim()"</p>
                        }
                        else
                        {
                            <span class="t-menu-head">
                                @(listFind.Trim().Length == 0
                                    ? $"Alle lister · {rows.Length}"
                                    : $"{rows.Length} {(rows.Length == 1 ? "liste" : "lister")}")
                            </span>
                            @foreach (var (g, i) in rows.Select((g, i) => (g, i)))
                            {
                                @ListRow(g, i == cursor)
                            }
                        }
                    </div>

                    @* The keys are here because this list is a hundred long:
                       reaching row sixty by Tab is not a path anybody takes. *@
                    <p class="grp-keys">
                        <span><kbd>↑</kbd><kbd>↓</kbd> flyt</span>
                        <span><kbd>↵</kbd> vælg</span>
                        <span><kbd>esc</kbd> luk</span>
                    </p>
                </div>
            }
        </div>

        @if (S.Lists.Count == 0)
        {
            @* Not an error — nothing has gone wrong, the question is simply
               still open. It says what belongs here and how to fill it. *@
            <p class="pick-none-yet">
                Ingen liste valgt endnu. Vælg en ovenfor, så står modtagerne her
                med den prisliste, hver af dem får.
            </p>
        }
        else
        {
        <p class="pick-count">
            <span>@S.Picked.Count af @S.People.Length personer med</span>
            <span class="pick-count-s">Klik en række for at se prislisten</span>
        </p>

        @* A table, not cards: at this size the eye wants columns to run down,
           and the header carries the one control cards had nowhere to put. *@
        <table class="pick-t">
            <thead>
                <tr>
                    <th scope="col" class="pick-t-box">
                        <input type="checkbox" aria-label="Vælg alle" checked="@AllPicked"
                               @onchange="ToggleAll" />
                    </th>
                    <th scope="col">Person</th>
                    <th scope="col">Kunde</th>
                    @if (S.Lists.Count > 1)
                    {
                        @* table-layout is fixed, so the width has to sit on the
                           header cell — the body's is never measured. *@
                        <th scope="col" class="pick-t-from">Liste</th>
                    }
                    <th scope="col" class="num">Prisliste</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in S.People)
                {
                    var person = p;
                    var on = S.Picked.Contains(person.Email);
                    var total = Accounting.SheetFor(person.Company).Sum(l => l.Total);
                    <tr @key="person.Email" data-on="@(on ? "" : null)" data-shown="@(S.Show?.Email == person.Email ? "" : null)"
                        tabindex="0" @onclick="() => ShowSheet(person, on)" @onkeydown="e => RowKey(e, person, on)">
                        <td class="pick-t-box" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@on" @onchange="() => Toggle(person.Email)"
                                   aria-label="Med i udsendelsen: @person.Name" />
                        </td>
                        <td class="pick-t-name" title="@person.Name">@person.Name</td>
                        <td class="pick-t-co" title="@person.Company">@person.Company</td>
                        @if (S.Lists.Count > 1)
                        {
                            var from = Where(person);
                            <td class="pick-t-from" title="@from">@from</td>
                        }
                        <td class="num">
                            @if (person.HasSheet)
                            {
                                @total.ToString("N0")
                            }
                            else
                            {
                                <span class="pick-none">Ingen prisliste</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        }

        @if (S.Errors.TryGetValue("recipients", out var rcpErr))
        {
            <p class="f-err">@Icons.Warn @rcpErr</p>
        }

        <p class="f-help">
            Beløbene kommer fra regnskabssystemet. To personer hos samme kunde får den samme prisliste.
        </p>
    }

    else if (TaskKey == "template")
    {
        @if (S.Langs.Length == 0)
        {
            <p class="pick-none-yet">
                Ingen modtagere endnu, så der er ikke noget sprog at skrive i.
                Vælg en liste i trin 1.
            </p>
        }
        else
        {
            @* One tab per language actually in play — never three when the send
               is Danish all the way through. Nobody picked these: the
               recipients' countries did. *@
            <div class="lang" role="tablist" aria-label="Sprog" @ref="langBar">
                @foreach (var code in S.Langs)
                {
                    var lang = code;
                    var count = S.Recipients.Count(r => r.Lang == lang);

                    <button type="button" class="lang-tab" role="tab" id="lang-@lang"
                            aria-selected="@(Lang == lang ? "true" : "false")"
                            aria-controls="lang-panel" tabindex="@(Lang == lang ? 0 : -1)"
                            @onclick="() => ShowLang(lang)" @onkeydown="e => LangKey(e, lang)">
                        @Templates.Name(lang)
                        <span class="lang-n">@count</span>
                    </button>
                }
            </div>

            <div class="lang-panel" id="lang-panel" role="tabpanel" aria-labelledby="lang-@Lang">
                <div class="f-group">
                    <label class="f-label" for="f-subject">Emne</label>
                    <input class="f-input" id="f-subject" type="text"
                           value="@S.LetterFor(Lang).Subject"
                           @oninput="e => Write(subject: e.Value?.ToString() ?? string.Empty)"
                           aria-invalid="@Invalid("template")" />
                </div>

                <div class="f-group">
                    <label class="f-label" for="f-body">Tekst</label>
                    <textarea class="f-input f-textarea" id="f-body" rows="9"
                              value="@S.LetterFor(Lang).Body"
                              @oninput="e => Write(body: e.Value?.ToString() ?? string.Empty)"></textarea>
                </div>

                @if (S.Errors.TryGetValue("template", out var tplErr))
                {
                    <p class="f-err">@Icons.Warn @tplErr</p>
                }

                <p class="f-help">
                    <code>{navn}</code> og <code>{firma}</code> sættes ind pr. modtager.
                    Prislisten hænger ved uanset sproget.
                </p>
            </div>
        }
    }

    else if (TaskKey == "send")
    {
        @* The totals the side rail used to carry, where the decision is made. *@
        <p class="send-sum">
            <b>@S.Picked.Count @(S.Picked.Count == 1 ? "mail" : "mails")</b> med
            @S.Companies @(S.Companies == 1 ? "prisliste" : "prislister") på
            @S.Langs.Length @(S.Langs.Length == 1 ? "sprog" : "sprog") ·
            <b>@S.Total.ToString("N0")</b> i alt.
        </p>

        <fieldset class="f-fieldset send-w">
            <legend class="sr-only">Hvor udsendelsen skal ende</legend>

            @Where("Læg den i CRM", "Hver mail havner på kundens kort, så den står der næste gang nogen kigger.",
                   S.ViaCrm, on => { S.ViaCrm = on; S.Errors.Remove("send"); })
            @Where("Gem en kopi lokalt", "Mailen og de vedhæftede ark lægges i udsendelsesmappen.",
                   S.SaveLocally, on => { S.SaveLocally = on; S.Errors.Remove("send"); })
            @Where("Send en kopi til mig selv", "Én mail til dig, så du kan se hvad der gik ud.",
                   S.CopyToMe, on => S.CopyToMe = on)
        </fieldset>

        @if (S.Errors.TryGetValue("send", out var sendErr))
        {
            <p class="f-err">@Icons.Warn @sendErr</p>
        }

        <p class="f-help">Intet sendes, før du trykker Send mail.</p>
    }

</div>

@code {
    [Parameter, EditorRequired] public string TaskKey { get; set; } = "";

    /// Raised when the answer changed, so the sidebar's summaries repaint.
    [Parameter] public EventCallback Changed { get; set; }

    /// Enter pressed in a field.
    [Parameter] public EventCallback Submit { get; set; }

    private ElementReference root;

    // ---- the marketing list picker ----

    private bool listOpen;
    private string listFind = "";
    private string? focusWanted;
    private int cursor;
    private bool showCursor;

    /// The lists this workspace actually sends to, most first. Use, not order:
    /// the one you sent to yesterday is not the one you send to every week.
    /// Ties go to whoever was used last.
    private IEnumerable<Group> MostUsed =>
        MarketingGroup.Lists
            .Select(list => (list, sends: Sends(list), last: Sent(list).Select(m => m.Sent).DefaultIfEmpty("").Max()))
            .Where(x => x.sends > 0)
            .OrderByDescending(x => x.sends)
            .ThenByDescending(x => x.last, StringComparer.Ordinal)
            .Take(3)
            .Select(x => x.list);

    /// Sent, not written: a draft naming a list has not gone anywhere yet, and
    /// counting it would put a list on the cards for something nobody did. Its
    /// "—" for a date would also sort above every real one.
    private IEnumerable<Mail> Sent(Group group) =>
        Store.All.Where(m => m.Status == MailStatus.Sent && m.Lists.Contains(group.Name));

    private int Sends(Group group) => Sent(group).Count();

    private string Used(Group group) =>
        Sends(group) is var n && n > 0 ? $" · brugt {n} {(n == 1 ? "gang" : "gange")}" : "";

    /// The three on screen. The chosen list is always one of them, even when it
    /// came from the long tail — otherwise picking it would make it vanish.
    private IEnumerable<Group> Cards =>
        S.Lists.Where(l => !MostUsed.Any(m => m.Name == l.Name))
            .Concat(MostUsed)
            .Take(3);


    /// A card or row that cannot take a click: the second list is chosen, and
    /// this is not one of them. Told, not hidden — the rule line says why.
    private bool Blocked(Group group) => !S.Chosen(group) && !S.RoomForMore;

    /// What the sheet is showing: the search's hits, or every list by name.
    private Group[] Rows() =>
        listFind.Trim().Length > 0
            ? MailDraft.Search(listFind).ToArray()
            : MarketingGroup.Lists.OrderBy(l => l.Name, StringComparer.CurrentCulture).ToArray();

    private RenderFragment ListRow(Group group, bool at) =>
        @<button type="button" class="t-menu-item grp-row" role="option" id="@(at ? "grp-row-at" : null)"
                 data-cursor="@(at ? "" : null)"
                 aria-selected="@(S.Chosen(group) ? "true" : "false")"
                 aria-disabled="@(Blocked(group) ? "true" : null)"
                 @onclick="() => Pick(group)">
            <span class="t-menu-ico">@if (S.Chosen(group)) { @Icons.TickSm }</span>
            <span class="grp-row-txt">
                <span class="grp-row-name">@group.Name</span>
                @* Parenthesised: after a word, a bare @ reads as an email address
                   to Razor and lands in the page as text. *@
                <span class="grp-row-s">@group.People.Length personer · @group.Customers kunder@(Used(group))</span>
            </span>
            <span class="grp-row-sum num">@group.Total.ToString("N0")</span>
        </button>;

    /// A click in the field is the question; the list is the answer, so it
    /// opens right there. Tabbing past on the way to the next step is not, so
    /// plain focus opens nothing.
    private void OpenLists()
    {
        if (listOpen) return;

        listOpen = true;
        cursor = 0;
    }

    private void CloseLists()
    {
        if (!listOpen) return;

        listOpen = false;
        listFind = "";
        focusWanted = "grp-find";
    }

    /// Typing changes what the list holds, so the keyboard's place goes back to
    /// the top rather than pointing at whatever now happens to sit at row nine.
    /// A word with nothing under it is the one thing worth not showing.
    private void FindChanged(string word)
    {
        listFind = word;
        cursor = 0;
        listOpen = true;
        focusWanted = word.Length == 0 ? "grp-find" : null;
    }

    /// A click on a list adds it, or takes it off again. The sheet closes
    /// either way: what changed is on the cards behind it, and a hundred rows
    /// left standing over the answer is not a view of anything.
    private async Task Pick(Group group)
    {
        if (Blocked(group)) return;

        S.Toggle(group);
        CloseLists();
        await Changed.InvokeAsync();
    }

    /// Escape closes it; the arrows walk the list and Enter takes the row they
    /// are standing on — a hundred rows is too many to reach by Tab. The field
    /// keeps focus throughout: it is the control, and the list is its answer.
    private async Task ListKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { CloseLists(); return; }

        if (!listOpen)
        {
            if (e.Key is "ArrowDown" or "Enter") OpenLists();
            return;
        }

        var rows = Rows();
        if (rows.Length == 0) return;

        switch (e.Key)
        {
            case "ArrowDown": cursor = Math.Min(cursor + 1, rows.Length - 1); showCursor = true; break;
            case "ArrowUp": cursor = Math.Max(cursor - 1, 0); showCursor = true; break;
            case "Home": cursor = 0; showCursor = true; break;
            case "End": cursor = rows.Length - 1; showCursor = true; break;
            case "Enter": await Pick(rows[cursor]); break;
        }
    }

    /// The arrows walk the three cards; Space and Enter turn one on or off.
    /// They no longer choose as they pass: with two lists allowed, arrowing
    /// across would switch lists on behind you.
    private void CardKey(KeyboardEventArgs e, int index)
    {
        var step = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => 1,
            "ArrowLeft" or "ArrowUp" => -1,
            _ => 0,
        };

        if (step == 0) return;

        var count = Cards.Count();
        focusWanted = $"grp-card-{(index + step + count) % count}";
    }

    private bool AllPicked => S.People.Length > 0 && S.People.All(p => S.Picked.Contains(p.Email));

    /// Which of the chosen lists this person came in on. "Begge" rather than
    /// both names: the names are on the cards two rows up.
    private string Where(Person person)
    {
        var on = S.Lists.Where(l => l.People.Any(p => p.Email == person.Email)).ToArray();
        return on.Length > 1 ? "Begge" : on.Length == 1 ? on[0].Name : "";
    }

    private async Task ToggleAll()
    {
        var all = AllPicked;

        foreach (var person in S.People)
        {
            if (S.Picked.Contains(person.Email) == all) S.Toggle(person.Email);
        }

        await Changed.InvokeAsync();
    }

    /// The row shows what that person would get; the box in it decides whether
    /// they get anything. Somebody who is off has no sheet to show.
    private async Task ShowSheet(Person person, bool on)
    {
        if (!on || !person.HasSheet) return;

        S.ShowPerson(person.Email);
        await Changed.InvokeAsync();
    }

    private async Task RowKey(KeyboardEventArgs e, Person person, bool on)
    {
        if (e.Key is "Enter" or " ") await ShowSheet(person, on);
    }

    private string? Invalid(string key) => S.Errors.ContainsKey(key) ? "true" : null;

    private Task NotifyChanged() => Changed.InvokeAsync();

    public ValueTask FocusFirstAsync() => JS.InvokeVoidAsync("app.focusFirst", root);

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (focusWanted is { } id)
        {
            focusWanted = null;
            await JS.InvokeVoidAsync("app.focusId", id);
        }

        if (showCursor)
        {
            showCursor = false;
            await JS.InvokeVoidAsync("app.showRow", "grp-row-at");
        }
    }

    private async Task Toggle(string email)
    {
        S.Toggle(email);
        await Changed.InvokeAsync();
    }

    // ---- the template step ----

    private ElementReference langBar;
    private string? langShown;

    /// The language on screen: the one asked for, while it is still in play.
    /// Take the last Swede off the list and the Swedish tab goes with them.
    private string Lang =>
        langShown is { } asked && S.Langs.Contains(asked) ? asked : S.Langs.FirstOrDefault() ?? Templates.En;

    /// Choosing a language points the preview at somebody who speaks it: a
    /// letter with no reader on the other side of the pane is just text.
    private async Task ShowLang(string lang)
    {
        langShown = lang;

        if (S.Recipients.FirstOrDefault(r => r.Lang == lang) is { } who && who.Email != S.Show?.Email)
        {
            S.ShowPerson(who.Email);
        }

        await Changed.InvokeAsync();
    }

    /// And the other way round: the pane beside this one showed somebody, so
    /// the tab moves to the letter that person actually gets.
    private int seenShow;

    protected override void OnParametersSet()
    {
        if (S.Show is not { } ask || ask.Nonce == seenShow) return;

        seenShow = ask.Nonce;

        if (S.Recipients.FirstOrDefault(r => r.Email == ask.Email) is { } who) langShown = who.Lang;
    }

    private async Task Write(string? subject = null, string? body = null)
    {
        S.Write(Lang, subject, body);
        await Changed.InvokeAsync();
    }

    /// A tab strip is one stop on the tab key; the arrows move between the tabs.
    private async Task LangKey(KeyboardEventArgs e, string lang)
    {
        var step = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => 1,
            "ArrowLeft" or "ArrowUp" => -1,
            _ => 0,
        };

        if (step == 0) return;

        var langs = S.Langs;
        var next = langs[(Array.IndexOf(langs, lang) + step + langs.Length) % langs.Length];
        focusWanted = $"lang-{next}";
        await ShowLang(next);
    }

    // ---- the send step ----

    private RenderFragment Where(string title, string sub, bool on, Action<bool> set) =>
        @<label class="f-switch send-row">
            <input type="checkbox" checked="@on"
                   @onchange="async e => { set(e.Value is true); await Changed.InvokeAsync(); }" />
            <span class="f-track" aria-hidden="true"><span class="f-knob"></span></span>
            <span class="send-txt">
                <span class="f-sw-title">@title</span>
                <span class="f-sw-desc">@sub</span>
            </span>
        </label>;

    // Enter anywhere in the panel means "next step". The checkbox list handles
    // Space itself, which is what a checkbox expects.
    private Task RootKey(KeyboardEventArgs e) =>
        e.Key == "Enter" ? Submit.InvokeAsync() : Task.CompletedTask;
}
