@implements IDisposable
@inject MailDraft S
@inject MailStore Store
@inject AppState App
@inject IJSRuntime JS

<div class="split-page">

    @* The side menu already names the page and marks it current, so the title
       is here for a screen reader and gives its height to the panes. *@
    <h1 class="sr-only">Ny mail</h1>

    <div class="split" @ref="split">

        <div class="split-list split-form">

            @* Sits on the card rather than in the header's empty corner, where it
               lined up with nothing. Outside the panel, so it doesn't re-animate
               on every step change with the keyed panel. *@
            <div class="v3-progress">
                <div class="v3-progress-top">
                    <span class="v3-progress-n">@S.DoneCount af @Content.Tasks.Length udfyldt</span>
                    <span class="v3-progress-pct">@Pct%</span>
                </div>
                <div class="v3-meter-bar" role="progressbar" aria-label="Fremdrift"
                     aria-valuemin="0" aria-valuemax="@Content.Tasks.Length" aria-valuenow="@S.DoneCount">
                    <i style="transform:scaleX(@Fraction)"></i>
                </div>
            </div>

            @* Only the step content scrolls. The footer is a sibling band, exactly as
               .t-foot is on the list page — a sticky footer inside the scroller
               repaints against the scrollbar and jitters. *@
            <div class="v3-scroll">
                <section class="v3-panel" aria-labelledby="v3-panel-h" @key="S.StepKey">
                    <h2 class="v3-panel-h" id="v3-panel-h">@Task.Title</h2>
                    <p class="v3-panel-s">@Task.Sub</p>
                    <div class="v3-panel-body">
                        <Fields TaskKey="@Task.Key" Changed="S.NotifyChanged" Submit="() => Commit(false)" @ref="fields" />
                    </div>
                </section>
            </div>

            <div class="v3-panel-f">
                @* Back stays put and goes disabled at the start. An absent control says
                   nothing; a dimmed one says you are at the beginning. *@
                <button type="button" class="btn btn-ghost" data-act="back"
                        disabled="@(Prev is null)"
                        @onclick="() => S.Open(Prev!.Key)">@Icons.ArrowL Tilbage</button>

                <span class="v3-step-pos">Trin @(Index + 1) af @Content.Tasks.Length</span>

                <div class="v3-panel-f-end">
                    @if (justSaved == Task.Key)
                    {
                        <span class="v3-saved">@Icons.TickSm Gemt</span>
                    }
                    @if (!Task.Required)
                    {
                        <button type="button" class="btn btn-ghost" data-act="skip" @onclick="() => Commit(true)">Spring over</button>
                    }
                    @* The last step's button is the send. It used to be shadowed by
                       a second Send row in the side rail — one action, two primaries,
                       and the rail's copy could fire from a step where you had not
                       yet seen where the mail was going. *@
                    <button type="button" class="btn btn-primary" data-act="save" @onclick="() => Commit(false)">
                        @if (Next is null)
                        {
                            @Icons.Send
                            <text>Send mail</text>
                        }
                        else
                        {
                            <text>Gem og fortsæt</text>
                        }
                    </button>
                </div>
            </div>

        </div>

        <div class="splitter" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="Juster forhåndsvisningen" aria-valuemin="280" aria-valuenow="400"
             @ref="handle"></div>

        @* Composing in the same view the sent list shows afterwards, so the thing
           you are making looks like the thing you will get. *@
        <aside class="split-detail" aria-label="Sådan bliver mailen">
            <MailView M="S.Preview(Store.NextRef())" Preview="true" SheetEdited="SheetEdited"
                          Focus="S.Show" LetterFirst="@(S.StepKey == "template")" Showed="S.ShowPerson" />
        </aside>

    </div>
</div>

@code {
    private Fields? fields;
    private string? justSaved;

    private TaskDef Task => Content.Task(S.StepKey);
    private int Pct => (int)Math.Round(S.DoneCount / (double)Content.Tasks.Length * 100);
    private double Fraction => S.DoneCount / (double)Content.Tasks.Length;

    // Linear neighbours. The sidebar still allows any order; these walk the list.
    private int Index => Content.IndexOf(S.StepKey);
    private TaskDef? Prev => Index > 0 ? Content.Tasks[Index - 1] : null;
    private TaskDef? Next => Index < Content.Tasks.Length - 1 ? Content.Tasks[Index + 1] : null;

    private ElementReference handle;
    private ElementReference split;

    protected override void OnInitialized() => S.Changed += StateHasChanged;
    public void Dispose() => S.Changed -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        S.Nudge = null;

        if (first)
        {
            try
            {
                await JS.InvokeVoidAsync("app.splitter.attach", handle, split, "quote.previewWidth");
            }
            catch (JSException)
            {
                // A resizable divider is an enhancement; the pane still works fixed.
            }
        }

        if (S.FocusNext && fields is not null)
        {
            S.FocusNext = false;
            await fields.FocusFirstAsync();
        }
    }

    /// A price sheet was edited in the preview. The draft composes its
    /// recipients from the sheets, so saying so is enough to redraw it.
    private void SheetEdited() => S.NotifyChanged();

    private void Commit(bool skipped)
    {
        var key = S.StepKey;

        if (!skipped && !S.Validate(key))
        {
            S.FocusNext = true;
            return;
        }

        S.Errors.Clear();
        S.MarkVisited(key);
        justSaved = key;

        if (Next is { } next)
        {
            S.StepKey = next.Key;
            justSaved = null;
            S.FocusNext = true;
            S.NotifyChanged();
            return;
        }

        Send();
    }

    /// The one place the two pages meet: the draft becomes a row in the list,
    /// and the list opens on it.
    private void Send()
    {
        if (!S.ReadyToSend()) return;

        var mail = Store.Send(S);
        App.SelectOnArrival = mail.Ref;
        App.Page = AppPage.Sent;
        S.NotifyChanged();
    }
}
