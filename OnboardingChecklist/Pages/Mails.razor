@implements IDisposable
@inject IJSRuntime JS
@inject MailStore Store
@inject AppState App

@* Master–detail: the list on the left, the mail that was actually sent on the
   right. Sorting and filtering are plain LINQ. *@
<div class="split-page">

    @* The side menu already names the page and marks it current, so the title
       is here for a screen reader and gives its height to the panes. *@
    <h1 class="sr-only">Mails</h1>

    <div class="split" @ref="split">

        <div class="split-list">
            @if (openCol is not null)
            {
                <div class="t-backdrop" @onclick="Close"></div>
            }

            @* The table stays when a filter empties it. The filter being typed
               into lives in a header; unmounting the headers took the field away
               mid-word. *@
            <div class="split-scroll">
                <table class="t" role="grid">
                    <thead>
                        <tr>
                            @foreach (var c in Columns)
                            {
                                var col = c;
                                var sorted = sort == col.Key;
                                var filtered = IsFiltered(col.Key);
                                var isOpen = openCol == col.Key;
                                @* The header opens the column's dropdown, laid out like
                                   Outlook's sort menu: the order in the field's own words
                                   with a tick, then the column's filter. The arrow on the
                                   header shows only on the sorted column. *@
                                <th scope="col" class="@(col.Num ? "num" : null)" data-open="@(isOpen ? "" : null)"
                                    aria-sort="@(sorted ? (asc ? "ascending" : "descending") : "none")">
                                    <button type="button" class="t-th" id="th-@col.Key"
                                            aria-haspopup="dialog" aria-expanded="@(isOpen ? "true" : "false")"
                                            @onclick="() => Toggle(col.Key)">
                                        @* The mark leads the label in every column, and its slot is
                                           there even when empty, so the label never moves. *@
                                        @if (sorted && filtered)
                                        {
                                            @* Both at once: one mark, the way Outlook draws it. *@
                                            <span class="t-mark" role="img" aria-label="filtreret">@(asc ? Icons.SortFilterUp : Icons.SortFilterDown)</span>
                                        }
                                        else if (sorted)
                                        {
                                            <span class="t-mark t-sort" data-asc="@(asc ? "" : null)">@Icons.ArrowUp</span>
                                        }
                                        else if (filtered)
                                        {
                                            <span class="t-mark" role="img" aria-label="filtreret">@Icons.Filter</span>
                                        }
                                        else
                                        {
                                            <span class="t-mark"></span>
                                        }
                                        @col.Label
                                    </button>

                                    @if (isOpen)
                                    {
                                        var order = OrderLabels(col.Key);
                                        @* tabindex so a click on the panel's own background lands
                                           here rather than on the body, where Escape stops
                                           reaching the panel that is open. *@
                                        <div class="t-menu" role="dialog" tabindex="-1" aria-label="Sortér og filtrér @col.Label"
                                             @ref="menu" @onkeydown="MenuKey">
                                            <span class="t-menu-head">Sorteringsrækkefølge</span>
                                            @* Low end first, as Outlook lists it: Ældste before
                                               Nyeste, A before Å. *@
                                            <button type="button" class="t-menu-item" aria-pressed="@(sorted && asc ? "true" : "false")"
                                                    @onclick="() => SetSort(col.Key, true)">
                                                <span class="t-menu-ico">@if (sorted && asc) { @Icons.TickSm }</span>
                                                @order.Asc
                                            </button>
                                            <button type="button" class="t-menu-item" aria-pressed="@(sorted && !asc ? "true" : "false")"
                                                    @onclick="() => SetSort(col.Key, false)">
                                                <span class="t-menu-ico">@if (sorted && !asc) { @Icons.TickSm }</span>
                                                @order.Desc
                                            </button>

                                            @if (col.Filter is { } heading)
                                            {
                                                var shown = Shown(col.Key).ToArray();
                                                <div class="t-menu-filter">
                                                    <span class="t-menu-head">@heading</span>
                                                    @* The field shortens this list and nothing else — the
                                                       table answers to the boxes, as in a spreadsheet. *@
                                                    <div class="t-find">
                                                        <span class="t-find-ico">@Icons.Search</span>
                                                        <input class="t-find-input" id="find-@col.Key" type="search" placeholder="Søg"
                                                               autocomplete="off" spellcheck="false" data-1p-ignore data-lpignore="true"
                                                               value="@Find(col.Key)"
                                                               @oninput="e => SetFind(col.Key, e.Value?.ToString() ?? string.Empty)" />
                                                        @if (Find(col.Key).Length > 0)
                                                        {
                                                            <button type="button" class="t-find-x" aria-label="Ryd søgning"
                                                                    @onclick="() => ClearFind(col.Key)">@Icons.X</button>
                                                        }
                                                    </div>
                                                    @if (shown.Length == 0)
                                                    {
                                                        <p class="t-menu-none">Ingen der hedder noget med "@Find(col.Key).Trim()"</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="t-menu-list">
                                                            @foreach (var v in shown)
                                                            {
                                                                var value = v;
                                                                <li>
                                                                    <label class="t-menu-check">
                                                                        <input type="checkbox" checked="@Chosen(col.Key).Contains(value)"
                                                                               @onchange="() => TogglePick(col.Key, value)" />
                                                                        <span title="@value">@value</span>
                                                                    </label>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            }

                                            @if (filtered)
                                            {
                                                <button type="button" class="t-menu-clear" @onclick="() => ClearColumn(col.Key)">Ryd filter</button>
                                            }
                                        </div>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Rows)
                        {
                            var row = r;
                            <tr @key="row.Ref" tabindex="0"
                                data-picked="@(picked == row.Ref ? "" : null)"
                                aria-selected="@(picked == row.Ref ? "true" : "false")"
                                @onclick="() => picked = row.Ref"
                                @onkeydown="e => RowKey(e, row.Ref)">
                                <td class="t-ref">@row.Ref</td>
                                <td>
                                    <span class="t-client" title="@row.Subject">@row.Subject</span>
                                    <span class="t-sub">@row.Responses</span>
                                </td>
                                <td class="num">@(row.Recipients.Length == 0 ? "—" : $"{row.Recipients.Length} · {row.Companies} {(row.Companies == 1 ? "kunde" : "kunder")}")</td>
                                <td class="num">@(row.Recipients.Length == 0 ? "—" : row.Total.ToString("N0"))</td>
                                <td class="num t-muted">@row.Sent</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Rows.Length == 0)
                {
                    <div class="t-empty">
                        <p class="t-empty-h">Ingen udsendelser matcher filtrene</p>
                        <p class="t-empty-b">Ryd dem for at se alle @Store.All.Count igen.</p>
                        <button type="button" class="btn btn-outline" @onclick="ClearFilters">Ryd filtre</button>
                    </div>
                }
            </div>

            @if (Rows.Length > 0)
            {
                <p class="t-foot">
                    @Rows.Length af @Store.All.Count udsendelser
                    @if (AnyFilter)
                    {
                        <span class="t-foot-sep">·</span>
                        <button type="button" class="t-foot-clear" @onclick="ClearFilters">Ryd filtre</button>
                    }
                </p>
            }
        </div>

        <div class="splitter" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="Juster bredden på ruden" aria-valuemin="280" aria-valuenow="400"
             @ref="handle"></div>

        <aside class="split-detail" aria-label="Den valgte mail">
            @if (Picked is { } q)
            {
                <MailView M="q" />
            }
            else
            {
                <div class="d-empty">
                    @Icons.Sheet
                    <p class="d-empty-h">Ingen mail valgt</p>
                    <p class="d-empty-b">Vælg en udsendelse til venstre for at se modtagerne og den prisliste hver enkelt fik.</p>
                </div>
            }
        </aside>

    </div>
</div>

@code {
    /// A column with Filter set offers one, and the string heads its list, the
    /// way "Sorteringsrækkefølge" heads the orders. "Gik til" on Modtagere:
    /// the column counts customers while the list names them.
    private record Col(string Key, string Label, bool Num = false, string? Filter = null);

    private static readonly Col[] Columns =
    [
        new("ref", "Reference", Filter: "Vis"),
        new("subject", "Emne", Filter: "Vis"),
        new("recipients", "Modtagere", true, "Gik til"),
        new("total", "I alt", true),
        new("sent", "Sendt", true),
    ];

    /// Direction in the field's own words, as Outlook says it. "Nyeste øverst"
    /// says what you will see; "Faldende" has to be translated, and means
    /// something different for a date, a sum and a name.
    private static (string Asc, string Desc) OrderLabels(string key) => key switch
    {
        "sent" => ("Ældste øverst", "Nyeste øverst"),
        "total" => ("Mindst øverst", "Størst øverst"),
        "recipients" => ("Færrest øverst", "Flest øverst"),
        _ => ("A til Å", "Å til A"),
    };

    /// Picking an order sorts by the column and closes, as Outlook's menu
    /// does; the arrow on the header then says which way.
    private void SetSort(string key, bool ascending)
    {
        sort = key;
        asc = ascending;
        Close();
    }

    /// "Ryd filter" unmounts itself once the column is clear, so focus goes
    /// back into the panel rather than falling to the body.
    private void ClearColumn(string key)
    {
        Chosen(key).Clear();
        finds[key] = "";
        focusMenu = true;
    }

    private string? openCol;
    private ElementReference menu;
    private bool focusMenu;
    private string? focusAfter;

    /// The values chosen per column, and the word narrowing that column's
    /// list. The word never reaches the table: it only shortens what the
    /// dropdown offers, the way a spreadsheet's filter search does.
    private readonly Dictionary<string, HashSet<string>> picks = [];
    private readonly Dictionary<string, string> finds = [];

    private HashSet<string> Chosen(string key) =>
        picks.TryGetValue(key, out var set) ? set : picks[key] = [];

    private string Find(string key) => finds.GetValueOrDefault(key, "");

    /// What a column can be filtered by. Modtagere lists the companies a send
    /// went to, which is what the cell counts rather than what it prints.
    private IEnumerable<string> Values(string key) => key switch
    {
        "recipients" => Store.All.SelectMany(m => m.Recipients).Select(r => r.Company),
        "subject" => Store.All.Select(m => m.Subject),
        _ => Store.All.Select(m => m.Ref),
    };

    private IEnumerable<string> Shown(string key)
    {
        var all = Values(key).Distinct().Order();
        var word = Find(key).Trim();
        return word.Length == 0 ? all : all.Where(v => v.Contains(word, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsFiltered(string key) => Chosen(key).Count > 0;

    private bool AnyFilter => Columns.Any(c => IsFiltered(c.Key));

    private void TogglePick(string key, string value)
    {
        if (!Chosen(key).Remove(value)) Chosen(key).Add(value);
        KeepSelectionVisible();
    }

    private void SetFind(string key, string word) => finds[key] = word;

    /// Clearing the word hides the button doing it, so focus goes back to the
    /// field it belongs to.
    private void ClearFind(string key)
    {
        finds[key] = "";
        focusAfter = $"find-{key}";
    }

    private void ClearFilters()
    {
        picks.Clear();
        finds.Clear();
        openCol = null;
    }

    private void Toggle(string key)
    {
        openCol = openCol == key ? null : key;
        focusMenu = openCol is not null;
    }

    /// Escape closes and hands focus back to the header that opened the panel,
    /// or it would land on the body when the panel unmounts.
    private void MenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Close()
    {
        focusAfter = $"th-{openCol}";
        openCol = null;
    }
    private string sort = "sent";
    private bool asc;
    private string? picked;

    /// The list opens on something. What you just sent, if you came straight
    /// from sending it; otherwise the newest send-out, because an empty detail
    /// pane is half a screen asking a question it already knows the answer to.
    protected override void OnInitialized()
    {
        Store.Changed += StateHasChanged;

        picked = App.SelectOnArrival ?? Newest?.Ref;
        App.SelectOnArrival = null;
    }

    /// Newest means most recently sent. A draft has no date to be newest by —
    /// it is what you are still writing, not what went out last.
    private Mail? Newest =>
        Store.All.Where(m => m.Status == MailStatus.Sent)
                 .OrderByDescending(m => m.Sent, StringComparer.Ordinal)
                 .FirstOrDefault()
        ?? Store.All.FirstOrDefault();

    public void Dispose() => Store.Changed -= StateHasChanged;

    private ElementReference handle;
    private ElementReference split;


    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (focusMenu)
        {
            focusMenu = false;
            await JS.InvokeVoidAsync("app.focusIn", menu);
        }
        else if (focusAfter is { } id)
        {
            focusAfter = null;
            await JS.InvokeVoidAsync("app.focusId", id);
        }

        if (!first) return;

        try
        {
            await JS.InvokeVoidAsync("app.splitter.attach", handle, split, "sent.detailWidth");
        }
        catch (JSException)
        {
            // A resizable divider is an enhancement — without it the pane is
            // simply fixed-width. Losing the whole page over it is worse.
        }
    }

    private Mail? Picked => picked is null ? null : Store.All.FirstOrDefault(m => m.Ref == picked);

    private Mail[] Rows
    {
        get
        {
            IEnumerable<Mail> rows = Store.All;

            var refs = Chosen("ref");
            if (refs.Count > 0) rows = rows.Where(r => refs.Contains(r.Ref));

            var subjects = Chosen("subject");
            if (subjects.Count > 0) rows = rows.Where(r => subjects.Contains(r.Subject));

            // A send has many customers, so this one looks inside the row.
            var companies = Chosen("recipients");
            if (companies.Count > 0) rows = rows.Where(r => r.Recipients.Any(x => companies.Contains(x.Company)));

            Func<Mail, IComparable> key = sort switch
            {
                "ref" => r => r.Ref,
                "subject" => r => r.Subject,
                "recipients" => r => r.Recipients.Length,
                "total" => r => r.Total,
                _ => r => r.Sent,
            };

            var ordered = asc ? rows.OrderBy(key) : rows.OrderByDescending(key);

            // A draft has no date. "—" sorts above every real date descending, so
            // undated rows get pushed to the bottom in both directions.
            return ordered.OrderBy(r => r.Sent == "—" ? 1 : 0).ToArray();
        }
    }


    /// A selection the filters have hidden would leave the detail pane showing
    /// a send the list no longer offers. It moves to the top of what is left
    /// rather than to nothing — the same reason the list opens on a row.
    private void KeepSelectionVisible()
    {
        if (picked is not null && !Rows.Any(r => r.Ref == picked)) picked = Rows.FirstOrDefault()?.Ref;
    }

    private void RowKey(KeyboardEventArgs e, string reference)
    {
        if (e.Key is "Enter" or " ") picked = reference;
    }
}
