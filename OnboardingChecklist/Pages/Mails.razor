@implements IDisposable
@inject IJSRuntime JS
@inject MailStore Store
@inject AppState App

@* Master–detail: the list on the left, the mail that was actually sent on the
   right. Sorting and filtering are plain LINQ. *@
<div class="split-page">

    <header class="split-head">
        <h1 class="page-h1">Mails</h1>
        <p class="page-lede">Hver udsendelse går til flere kunder — én prisliste hver.</p>
    </header>

    <div class="split" @ref="split">

        <div class="split-list">
            @* Filters sit over the list rather than on a column: "Gik til" narrows
               by company, which no column shows. The button says how many are on
               without opening. Sorting is on the headers. *@
            <div class="list-bar">
                <div class="tb">
                    <button type="button" class="tb-btn" id="tb-filter"
                            aria-haspopup="dialog" aria-expanded="@(openMenu == "filter" ? "true" : "false")"
                            data-on="@(AnyFilter ? "" : null)" @onclick="@(() => Toggle("filter"))">
                        @Icons.Filter
                        <span>Filtrer</span>
                        @if (FilterCount > 0)
                        {
                            <span class="tb-count">@FilterCount</span>
                        }
                    </button>

                    @if (openMenu == "filter")
                    {
                        <div class="t-menu tb-menu" role="dialog" aria-label="Filtre" @ref="menu" @onkeydown="MenuKey">
                            <div class="t-menu-filter t-menu-filter-first">
                                <label class="t-menu-lbl" for="flt-ref">Reference indeholder</label>
                                <input class="f-input t-menu-input" id="flt-ref" type="text" autocomplete="off" spellcheck="false"
                                       value="@refFilter" @oninput='e => SetText("ref", e.Value?.ToString() ?? string.Empty)' />
                            </div>
                            <div class="t-menu-filter">
                                <label class="t-menu-lbl" for="flt-subject">Emne indeholder</label>
                                <input class="f-input t-menu-input" id="flt-subject" type="text" autocomplete="off" spellcheck="false"
                                       value="@subjectFilter" @oninput='e => SetText("subject", e.Value?.ToString() ?? string.Empty)' />
                            </div>
                            <div class="t-menu-filter">
                                <span class="t-menu-lbl">Gik til</span>
                                <ul class="t-menu-list">
                                    @foreach (var co in Companies)
                                    {
                                        var company = co;
                                        <li>
                                            <label class="t-menu-check">
                                                <input type="checkbox" checked="@companies.Contains(company)"
                                                       @onchange="() => ToggleCompany(company)" />
                                                <span title="@company">@company</span>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            </div>
                            @if (AnyFilter)
                            {
                                <button type="button" class="t-menu-clear" @onclick="ClearAllInMenu">Ryd filtre</button>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (openMenu is not null)
            {
                <div class="t-backdrop" @onclick="Close"></div>
            }

            @if (Rows.Length == 0)
            {
                <div class="t-empty">
                    <p class="t-empty-h">Ingen udsendelser matcher filtrene</p>
                    <p class="t-empty-b">Ryd dem for at se alle @Store.All.Count igen.</p>
                    <button type="button" class="btn btn-outline" @onclick="ClearFilters">Ryd filtre</button>
                </div>
            }
            else
            {
                <div class="split-scroll">
                    <table class="t" role="grid">
                        <thead>
                            <tr>
                                @foreach (var c in Columns)
                                {
                                    var col = c;
                                    var sorted = sort == col.Key;
                                    @* The header is the sort control, as in every table. The
                                       arrow is always there: on the sorted column it says which
                                       way; on the others it shows on hover which way a click
                                       would start. *@
                                    <th scope="col" class="@(col.Num ? "num" : null)"
                                        aria-sort="@(sorted ? (asc ? "ascending" : "descending") : "none")">
                                        <button type="button" class="t-th" @onclick="() => SortBy(col.Key)">
                                            @col.Label
                                            @if (IsFiltered(col.Key))
                                            {
                                                <span class="t-filtered" aria-label="filtreret"></span>
                                            }
                                            <span class="t-sort" data-on="@(sorted ? "" : null)"
                                                  data-asc="@((sorted ? asc : NaturalAsc(col.Key)) ? "" : null)">@Icons.ArrowUp</span>
                                        </button>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Rows)
                            {
                                var row = r;
                                <tr @key="row.Ref" tabindex="0"
                                    data-picked="@(picked == row.Ref ? "" : null)"
                                    aria-selected="@(picked == row.Ref ? "true" : "false")"
                                    @onclick="() => picked = row.Ref"
                                    @onkeydown="e => RowKey(e, row.Ref)">
                                    <td class="t-ref">@row.Ref</td>
                                    <td>
                                        <span class="t-client" title="@row.Subject">@row.Subject</span>
                                        <span class="t-sub">@row.Responses</span>
                                    </td>
                                    <td class="num">@(row.Recipients.Length == 0 ? "—" : $"{row.Recipients.Length} · {row.Companies} {(row.Companies == 1 ? "kunde" : "kunder")}")</td>
                                    <td class="num">@(row.Recipients.Length == 0 ? "—" : row.Total.ToString("N0"))</td>
                                    <td class="num t-muted">@row.Sent</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="t-foot">
                    @Rows.Length af @Store.All.Count udsendelser
                    @if (AnyFilter)
                    {
                        <span class="t-foot-sep">·</span>
                        <button type="button" class="t-foot-clear" @onclick="ClearFilters">Ryd filtre</button>
                    }
                </p>
            }
        </div>

        <div class="splitter" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="Resize the detail pane" aria-valuemin="280" aria-valuenow="400"
             @ref="handle"></div>

        <aside class="split-detail" aria-label="Den valgte mail">
            @if (Picked is { } q)
            {
                <MailView M="q" />
            }
            else
            {
                <div class="d-empty">
                    @Icons.Sheet
                    <p class="d-empty-h">Ingen mail valgt</p>
                    <p class="d-empty-b">Vælg en udsendelse til venstre for at se modtagerne og den prisliste hver enkelt fik.</p>
                </div>
            }
        </aside>

    </div>
</div>

@code {
    private record Col(string Key, string Label, bool Num = false);

    private static readonly Col[] Columns =
    [
        new("ref", "Reference"),
        new("subject", "Emne"),
        new("recipients", "Modtagere", true),
        new("total", "I alt", true),
        new("sent", "Sendt", true),
    ];

    private int FilterCount => Columns.Count(c => IsFiltered(c.Key));

    /// Clicking the sorted column turns it round; any other column starts in
    /// its natural direction.
    private void SortBy(string key)
    {
        if (sort == key)
        {
            asc = !asc;
            return;
        }

        sort = key;
        asc = NaturalAsc(key);
    }

    /// A first for text; newest, largest and most first for a date, a sum and
    /// a count.
    private static bool NaturalAsc(string key) => key is "ref" or "subject";

    private void ClearAllInMenu()
    {
        refFilter = "";
        subjectFilter = "";
        companies.Clear();
        focusMenu = true;
    }

    private string? openMenu;
    private string refFilter = "";
    private string subjectFilter = "";
    private readonly HashSet<string> companies = [];
    private ElementReference menu;
    private bool focusMenu;
    private string? returnFocusTo;

    private IEnumerable<string> Companies =>
        Store.All.SelectMany(m => m.Recipients).Select(r => r.Company).Distinct().Order();

    private bool IsFiltered(string key) => key switch
    {
        "ref" => refFilter.Trim().Length > 0,
        "subject" => subjectFilter.Trim().Length > 0,
        "recipients" => companies.Count > 0,
        _ => false,
    };

    private bool AnyFilter => Columns.Any(c => IsFiltered(c.Key));

        private void SetText(string key, string value)
    {
        if (key == "ref") refFilter = value; else subjectFilter = value;
        KeepSelectionVisible();
    }

    private void ToggleCompany(string company)
    {
        if (!companies.Remove(company)) companies.Add(company);
        KeepSelectionVisible();
    }

    private void ClearFilters()
    {
        refFilter = "";
        subjectFilter = "";
        companies.Clear();
        openMenu = null;
    }

    private void Toggle(string which)
    {
        openMenu = openMenu == which ? null : which;
        focusMenu = openMenu is not null;
    }

    /// Escape closes and hands focus back to the button that opened the panel,
    /// or it would land on the body when the panel unmounts.
    private void MenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Close()
    {
        returnFocusTo = openMenu;
        openMenu = null;
    }
    private string sort = "sent";
    private bool asc;
    private string? picked;

    /// A quote sent from the other page arrives with its row already chosen, so
    /// the reader sees what they just sent instead of hunting for it.
    protected override void OnInitialized()
    {
        Store.Changed += StateHasChanged;

        if (App.SelectOnArrival is { } reference)
        {
            picked = reference;
            App.SelectOnArrival = null;
        }
    }

    public void Dispose() => Store.Changed -= StateHasChanged;

    private ElementReference handle;
    private ElementReference split;


    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (focusMenu)
        {
            focusMenu = false;
            await JS.InvokeVoidAsync("app.focusIn", menu);
        }
        else if (returnFocusTo is { } key)
        {
            returnFocusTo = null;
            await JS.InvokeVoidAsync("app.focusId", $"tb-{key}");
        }

        if (!first) return;

        try
        {
            await JS.InvokeVoidAsync("app.splitter.attach", handle, split, "sent.detailWidth");
        }
        catch (JSException)
        {
            // A resizable divider is an enhancement — without it the pane is
            // simply fixed-width. Losing the whole page over it is worse.
        }
    }

    private Mail? Picked => picked is null ? null : Store.All.FirstOrDefault(m => m.Ref == picked);

    private Mail[] Rows
    {
        get
        {
            IEnumerable<Mail> rows = Store.All;

            var rf = refFilter.Trim();
            if (rf.Length > 0) rows = rows.Where(r => r.Ref.Contains(rf, StringComparison.OrdinalIgnoreCase));

            var sf = subjectFilter.Trim();
            if (sf.Length > 0) rows = rows.Where(r => r.Subject.Contains(sf, StringComparison.OrdinalIgnoreCase));

            // A send has many customers, so this one looks inside the row.
            if (companies.Count > 0) rows = rows.Where(r => r.Recipients.Any(x => companies.Contains(x.Company)));

            Func<Mail, IComparable> key = sort switch
            {
                "ref" => r => r.Ref,
                "subject" => r => r.Subject,
                "recipients" => r => r.Recipients.Length,
                "total" => r => r.Total,
                _ => r => r.Sent,
            };

            var ordered = asc ? rows.OrderBy(key) : rows.OrderByDescending(key);

            // A draft has no date. "—" sorts above every real date descending, so
            // undated rows get pushed to the bottom in both directions.
            return ordered.OrderBy(r => r.Sent == "—" ? 1 : 0).ToArray();
        }
    }


    /// A selection the filters have hidden would leave the detail pane showing
    /// a send the list no longer offers.
    private void KeepSelectionVisible()
    {
        if (picked is not null && !Rows.Any(r => r.Ref == picked)) picked = null;
    }

    private void RowKey(KeyboardEventArgs e, string reference)
    {
        if (e.Key is "Enter" or " ") picked = reference;
    }
}
