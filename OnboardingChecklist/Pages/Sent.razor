@implements IDisposable
@inject IJSRuntime JS
@inject QuoteStore Store
@inject AppState App

@* Master–detail: the list on the left, the mail that was actually sent on the
   right. Sorting and filtering are plain LINQ. *@
<div class="split-page">

    <header class="split-head">
        <h1 class="page-h1">Sent quotes</h1>
        <p class="page-lede">Every priced mail you've sent, newest first.</p>
    </header>

    <div class="split" @ref="split">

        <div class="split-list">
            @* Sits over the list it filters, and moves with the divider. In the
               page header it ended up above the detail pane instead. *@
            @* Collapsed to its icon while idle, because a whole band spent on an
               empty field earns nothing. It never collapses while filtering: a
               filtered list with no visible reason is worse than a wide field. *@
            <div class="list-bar">
                @if (searchOpen || query.Length > 0)
                {
                    <div class="search">
                        @Icons.Search
                        <input class="f-input" type="search" placeholder="Søg på kunde eller reference"
                               aria-label="Søg i tilbud" @ref="searchBox"
                               @bind="query" @bind:event="oninput" @bind:after="KeepSelectionVisible"
                               @onkeydown="SearchKey" />
                        <button type="button" class="search-clear" aria-label="Ryd søgning"
                                @onclick="ClearSearch">@Icons.X</button>
                    </div>
                }
                else
                {
                    <button type="button" class="search-open" aria-label="Søg i tilbud"
                            @ref="searchOpener" @onclick="OpenSearch">@Icons.Search</button>
                }
            </div>

            @if (Rows.Length == 0)
            {
                <div class="t-empty">
                    <p class="t-empty-h">No quotes match &ldquo;@query&rdquo;</p>
                    <p class="t-empty-b">Try a shorter search, or clear it to see all @Store.All.Count quotes.</p>
                    <button type="button" class="btn btn-outline" @onclick="ClearSearch">Ryd søgning</button>
                </div>
            }
            else
            {
                <div class="split-scroll">
                    <table class="t" role="grid">
                        <thead>
                            <tr>
                                @foreach (var c in Columns)
                                {
                                    var col = c;
                                    <th scope="col" class="@(col.Num ? "num" : null)"
                                        aria-sort="@(sort == col.Key ? (asc ? "ascending" : "descending") : "none")">
                                        <button type="button" class="t-th" @onclick="() => Sort(col.Key)">
                                            @col.Label
                                            <span class="t-sort" data-on="@(sort == col.Key ? "" : null)" data-asc="@(sort == col.Key && asc ? "" : null)">@Icons.Chevron</span>
                                        </button>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Rows)
                            {
                                var row = r;
                                <tr @key="row.Ref" tabindex="0"
                                    data-picked="@(picked == row.Ref ? "" : null)"
                                    aria-selected="@(picked == row.Ref ? "true" : "false")"
                                    @onclick="() => picked = row.Ref"
                                    @onkeydown="e => RowKey(e, row.Ref)">
                                    <td class="t-ref">@row.Ref</td>
                                    <td><span class="t-client" title="@row.Client">@row.Client</span></td>
                                    <td><span class="t-pill" data-s="@row.Status.ToString().ToLowerInvariant()">@row.Label</span></td>
                                    <td class="num">@(row.Lines.Length == 0 ? "—" : row.Amount.ToString("N0"))</td>
                                    <td class="num t-muted">@row.Sent</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="t-foot">@Rows.Length of @Store.All.Count quotes</p>
            }
        </div>

        <div class="splitter" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="Resize the detail pane" aria-valuemin="280" aria-valuenow="400"
             @ref="handle"></div>

        <aside class="split-detail" aria-label="Sent mail">
            @if (Picked is { } q)
            {
                <MailView Q="q" />
            }
            else
            {
                <div class="d-empty">
                    @Icons.Sheet
                    <p class="d-empty-h">Ingen mail valgt</p>
                    <p class="d-empty-b">Vælg en række til venstre for at se modtager, emne og priserne i den vedhæftede fil.</p>
                </div>
            }
        </aside>

    </div>
</div>

@code {
    private record Col(string Key, string Label, bool Num = false);

    private static readonly Col[] Columns =
    [
        new("ref", "Reference"),
        new("client", "Client"),
        new("status", "Status"),
        new("amount", "Amount", true),
        new("sent", "Sent", true),
    ];

    private string query = "";
    private string sort = "sent";
    private bool asc;
    private string? picked;

    /// A quote sent from the other page arrives with its row already chosen, so
    /// the reader sees what they just sent instead of hunting for it.
    protected override void OnInitialized()
    {
        Store.Changed += StateHasChanged;

        if (App.SelectOnArrival is { } reference)
        {
            picked = reference;
            App.SelectOnArrival = null;
        }
    }

    public void Dispose() => Store.Changed -= StateHasChanged;

    private ElementReference searchBox;
    private ElementReference handle;
    private ElementReference split;

    private ElementReference searchOpener;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (focusSearchBox)
        {
            focusSearchBox = false;
            await searchBox.FocusAsync(preventScroll: true);
        }
        else if (focusOpener)
        {
            focusOpener = false;
            await searchOpener.FocusAsync(preventScroll: true);
        }

        if (!first) return;

        try
        {
            await JS.InvokeVoidAsync("app.splitter.attach", handle, split, "sent.detailWidth");
        }
        catch (JSException)
        {
            // A resizable divider is an enhancement — without it the pane is
            // simply fixed-width. Losing the whole page over it is worse.
        }
    }

    private Quote? Picked => picked is null ? null : Store.All.FirstOrDefault(q => q.Ref == picked);

    private Quote[] Rows
    {
        get
        {
            var q = query.Trim();
            IEnumerable<Quote> rows = Store.All;

            if (q.Length > 0)
            {
                rows = rows.Where(r =>
                    r.Client.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Ref.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            Func<Quote, IComparable> key = sort switch
            {
                "ref" => r => r.Ref,
                "client" => r => r.Client,
                "status" => r => r.Status.ToString(),
                "amount" => r => r.Amount,
                _ => r => r.Sent,
            };

            var ordered = asc ? rows.OrderBy(key) : rows.OrderByDescending(key);

            // A draft has no date. "—" sorts above every real date descending, so
            // undated rows get pushed to the bottom in both directions.
            return ordered.OrderBy(r => r.Sent == "—" ? 1 : 0).ToArray();
        }
    }

    private void Sort(string key)
    {
        if (sort == key) { asc = !asc; return; }
        sort = key;
        asc = false;
    }

    private bool searchOpen;
    private bool focusSearchBox;
    private bool focusOpener;

    private void OpenSearch()
    {
        searchOpen = true;
        focusSearchBox = true;
    }

    /// Clearing collapses the field back to its icon, so focus has to follow it
    /// to the button that replaces it — otherwise it lands on the body.
    private void ClearSearch()
    {
        query = "";
        searchOpen = false;
        focusOpener = true;
        KeepSelectionVisible();
    }

    private void SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClearSearch();
    }

    /// A selection the filter has hidden would leave the detail pane showing
    /// something the list no longer offers.
    private void KeepSelectionVisible()
    {
        if (picked is not null && !Rows.Any(r => r.Ref == picked)) picked = null;
    }

    private void RowKey(KeyboardEventArgs e, string reference)
    {
        if (e.Key is "Enter" or " ") picked = reference;
    }
}
