@implements IDisposable
@inject AppState App
@inject OnboardingState S

@* App shell: a persistent side menu on the left, one page at a time on the right.
   No Router — two pages don't earn URL routing yet, and adding it would mean
   bringing back the App.razor/Router the project deliberately deleted. *@
<div class="app">

    <nav class="side" aria-label="Sections">
        <span class="side-brand" title="@Content.Workspace">@Content.Workspace</span>

        <div class="side-nav">
            <button type="button" class="side-nav-item"
                    data-active="@(App.Page == AppPage.Sent ? "" : null)"
                    aria-current="@(App.Page == AppPage.Sent ? "page" : null)"
                    @onclick="() => Go(AppPage.Sent)">
                @Icons.Inbox
                <span>Sent quotes</span>
                <span class="side-nav-count">@Quote.All.Length</span>
            </button>

            <button type="button" class="side-nav-item"
                    data-active="@(App.Page == AppPage.Quote ? "" : null)"
                    aria-current="@(App.Page == AppPage.Quote ? "page" : null)"
                    @onclick="() => Go(AppPage.Quote)">
                @Icons.Plus
                <span>New quote</span>
            </button>

            @if (App.Page == AppPage.Quote && !S.ChecklistDone)
            {
                <StepRail />
            }
        </div>
    </nav>

    <main class="main">
        @if (App.Page == AppPage.Sent)
        {
            <Sent />
        }
        else
        {
            <NewQuote />
        }
    </main>

</div>

@code {
    private void Go(AppPage page) => App.Page = page;

    // The steps nested under New quote have to appear and disappear as the
    // flow's own state changes, not just when the page switches.
    protected override void OnInitialized() => S.Changed += StateHasChanged;
    public void Dispose() => S.Changed -= StateHasChanged;
}
