@implements IDisposable
@inject AppState App
@inject MailDraft S
@inject MailStore Store

@* App shell: a persistent side menu on the left, one page at a time on the right.
   No Router — two pages don't earn URL routing yet, and adding it would mean
   bringing back the App.razor/Router the project deliberately deleted.
   The menu's layout is decided in docs/sidemenu.md. *@
<div class="app">

    <nav class="side" aria-label="Sections">
        @* On top, with the list between it and the draft: the draft and its steps
           are clicked all day, and a heavy button right above them is easy to
           hit by mistake. *@
        <div class="side-new">
            <button type="button" class="btn btn-primary" id="side-new"
                    aria-haspopup="@(S.Started && !S.Untouched ? "dialog" : null)"
                    @onclick="StartNew">
                @Icons.Plus Ny udsendelse
            </button>
        </div>

        <div class="side-nav">
            <button type="button" class="side-nav-item"
                    data-active="@(App.Page == AppPage.Sent ? "" : null)"
                    aria-current="@(App.Page == AppPage.Sent ? "page" : null)"
                    @onclick="() => Go(AppPage.Sent)">
                @Icons.Inbox
                <span>Udsendelser</span>
                <span class="side-nav-count">@Store.All.Count</span>
            </button>

            @if (S.Started)
            {
                var open = App.Page == AppPage.Quote;

                @* The draft and its steps on one ground: without it, the draft and
                   three steps shared an edge and a spacing and read as four equal
                   rows. The steps stay out on the list page too, so a step is one
                   click away from anywhere. *@
                <div class="side-draft">
                    <button type="button" class="side-draft-head"
                            data-active="@(open ? "" : null)"
                            aria-current="@(open ? "page" : null)"
                            @onclick="() => Go(AppPage.Quote)">
                        @Icons.Pencil
                        <span class="side-draft-txt">
                            <span class="side-draft-t" title="@S.Title"
                                  data-empty="@(S.Subject.Trim().Length == 0 ? "" : null)">@S.Title</span>
                            <span class="side-draft-s">Kladde · @S.Size</span>
                        </span>
                    </button>

                    <StepRail Here="open" />
                </div>
            }
        </div>
    </nav>

    <main class="main">
        @if (App.Page == AppPage.Sent)
        {
            <Mails />
        }
        else
        {
            <NewMail />
        }
    </main>

</div>

<StartOverDialog @ref="startOver" />

@code {
    private StartOverDialog? startOver;

    private void Go(AppPage page) => App.Page = page;

    /// One draft at a time. Only work gets a question; a draft nobody has
    /// changed is simply started again.
    private async Task StartNew()
    {
        if (S.Started && !S.Untouched && startOver is not null)
        {
            await startOver.OpenAsync();
            return;
        }

        App.Page = AppPage.Quote;
        S.StartOver();
    }

    // The draft's name and size change as it is written, and the count changes
    // when a send-out is sent.
    protected override void OnInitialized()
    {
        S.Changed += StateHasChanged;
        Store.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        S.Changed -= StateHasChanged;
        Store.Changed -= StateHasChanged;
    }
}
